    {
      "id": "privacy.edge-background-off",
      "name": "Microsoft Edge background activity off",
      "category": "Background & Privacy",
      "group": "Apps",
      "order": 50,
      "level": "Standard",
      "hint": "Stops Edge from preloading at sign-in (Startup Boost) and from running in the background after you close it.",
      "description": "Sets the Edge policies StartupBoostEnabled and BackgroundModeEnabled to 0. Edge no longer keeps processes running at sign-in or after its last window closes, freeing memory and CPU while you play. Edge itself keeps working; it starts slightly slower.",
      "evidence": {
        "tier": "A",
        "sources": [
          "https://learn.microsoft.com/en-us/deployedge/microsoft-edge-browser-policies/startupboostenabled",
          "https://learn.microsoft.com/en-us/deployedge/microsoft-edge-browser-policies/backgroundmodeenabled"
        ],
        "notes": "Edge shows 'Your browser is managed by your organization' while policies are set."
      },
      "impact": { "performance": "low", "latency": "none", "security": "0" },
      "risk": "low",
      "antiCheat": "safe",
      "reversible": "full",
      "sideEffects": "",
      "requires": "none",
      "appliesTo": { "minBuild": 26100 },
      "hardware": { "tags": [], "excludeTags": [] },
      "source": "igwt",
      "actions": [
        {
          "type": "registry",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge",
          "name": "StartupBoostEnabled",
          "valueType": "DWord",
          "on": 0,
          "default": "<absent>"
        },
        {
          "type": "registry",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge",
          "name": "BackgroundModeEnabled",
          "valueType": "DWord",
          "on": 0,
          "default": "<absent>"
        }
      ]
    },
    {
      "id": "privacy.update-active-hours",
      "name": "Windows Update active hours 10:00-04:00",
      "category": "Background & Privacy",
      "group": "Windows Update",
      "order": 50,
      "level": "Standard",
      "hint": "No automatic update restarts between 10:00 and 04:00 (18 h, the maximum). Updates still install; never disables updates.",
      "description": "Sets the documented active-hours policy (SetActiveHours = 1, start 10, end 4). Windows will not restart automatically for updates inside this window, protecting evening matches. Replaces the often-recommended NoAutoRebootWithLoggedOnUsers, which Microsoft says does not work as described and can block quality-update reboots entirely.",
      "evidence": {
        "tier": "A",
        "sources": [ "https://learn.microsoft.com/en-us/windows/deployment/update/waas-restart" ],
        "notes": "Maximum active-hours range is 18 hours. Settings shows active hours as managed while the policy is set."
      },
      "impact": { "performance": "none", "latency": "none", "security": "0" },
      "risk": "low",
      "antiCheat": "safe",
      "reversible": "full",
      "sideEffects": "",
      "requires": "none",
      "appliesTo": { "minBuild": 26100 },
      "hardware": { "tags": [], "excludeTags": [] },
      "source": "igwt",
      "actions": [
        {
          "type": "registry",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
          "name": "SetActiveHours",
          "valueType": "DWord",
          "on": 1,
          "default": "<absent>"
        },
        {
          "type": "registry",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
          "name": "ActiveHoursStart",
          "valueType": "DWord",
          "on": 10,
          "default": "<absent>"
        },
        {
          "type": "registry",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
          "name": "ActiveHoursEnd",
          "valueType": "DWord",
          "on": 4,
          "default": "<absent>"
        }
      ]
    },
    {
      "id": "privacy.keep-drivers",
      "name": "Keep my drivers (no driver updates via Windows Update)",
      "category": "Background & Privacy",
      "group": "Windows Update",
      "order": 50,
      "level": "Standard",
      "hint": "Stops Windows Update from replacing drivers (e.g. your NVIDIA driver). Update GPU, chipset and NIC drivers yourself.",
      "description": "Sets the ExcludeWUDriversInQualityUpdate policy to 1. Windows Update stops offering driver updates, so a newer or older OEM driver never silently replaces the NVIDIA driver you installed. Trade-off: you must update GPU, chipset, LAN and Bluetooth drivers yourself, including security fixes.",
      "evidence": {
        "tier": "A",
        "sources": [ "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-update#excludewudriversinqualityupdate" ],
        "notes": "Affects all drivers, not only the GPU."
      },
      "impact": { "performance": "none", "latency": "none", "security": "0" },
      "risk": "low",
      "antiCheat": "safe",
      "reversible": "full",
      "sideEffects": "",
      "requires": "none",
      "appliesTo": { "minBuild": 26100 },
      "hardware": { "tags": [], "excludeTags": [] },
      "source": "igwt",
      "actions": [
        {
          "type": "registry",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
          "name": "ExcludeWUDriversInQualityUpdate",
          "valueType": "DWord",
          "on": 1,
          "default": "<absent>"
        }
      ]
    },
    {
      "id": "privacy.background-apps-off",
      "name": "Background apps off (Store apps)",
      "category": "Background & Privacy",
      "group": "Apps",
      "order": 51,
      "level": "Advanced",
      "hint": "Stops Microsoft Store apps from running in the background. May delay Store-app notifications. Measure before/after.",
      "description": "Sets the LetAppsRunInBackground policy to 2 (force deny). Packaged (Store) apps can no longer run background tasks; classic desktop programs such as Discord or Steam are not affected. Notifications from Store apps (Mail, Phone Link, Xbox) may arrive late. The gain is usually small; measure before/after.",
      "evidence": {
        "tier": "B",
        "sources": [ "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-privacy#letappsruninbackground" ],
        "notes": "Situational trade-off."
      },
      "impact": { "performance": "low", "latency": "none", "security": "+" },
      "risk": "low",
      "antiCheat": "safe",
      "reversible": "full",
      "sideEffects": "",
      "requires": "none",
      "appliesTo": { "minBuild": 26100 },
      "hardware": { "tags": [], "excludeTags": [] },
      "source": "igwt",
      "actions": [
        {
          "type": "registry",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\AppPrivacy",
          "name": "LetAppsRunInBackground",
          "valueType": "DWord",
          "on": 2,
          "default": "<absent>"
        }
      ]
    },
    {
      "id": "privacy.reduce-visual-effects",
      "name": "Reduce animations and transparency",
      "category": "Background & Privacy",
      "group": "Desktop",
      "order": 52,
      "level": "Advanced",
      "hint": "Turns off window animations, taskbar animations and transparency. Snappier UI, not more FPS. Measure if in doubt.",
      "description": "Sets EnableTransparency = 0, MinAnimate = \"0\" and TaskbarAnimations = 0. Windows and the taskbar feel more immediate and the compositor does slightly less work on the desktop. In-game FPS does not change; measure if you want proof. Sign out to apply fully.",
      "evidence": {
        "tier": "B",
        "sources": [ "https://learn.microsoft.com/en-us/windows/win32/api/winuser/nf-winuser-systemparametersinfow" ],
        "notes": "UI responsiveness preference."
      },
      "impact": { "performance": "none", "latency": "low", "security": "0" },
      "risk": "low",
      "antiCheat": "safe",
      "reversible": "full",
      "sideEffects": "",
      "requires": "logoff",
      "appliesTo": { "minBuild": 26100 },
      "hardware": { "tags": [], "excludeTags": [] },
      "source": "igwt",
      "actions": [
        {
          "type": "registry",
          "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
          "name": "EnableTransparency",
          "valueType": "DWord",
          "on": 0,
          "default": 1,
          "absentValue": 1
        },
        {
          "type": "registry",
          "path": "HKCU:\\Control Panel\\Desktop\\WindowMetrics",
          "name": "MinAnimate",
          "valueType": "String",
          "on": "0",
          "default": "1",
          "absentValue": "1"
        },
        {
          "type": "registry",
          "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "name": "TaskbarAnimations",
          "valueType": "DWord",
          "on": 0,
          "default": "<absent>",
          "absentValue": 1
        }
      ]
    },
    {
