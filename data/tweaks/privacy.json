    {
      "id": "privacy.telemetry-tasks-off",
      "name": "Microsoft telemetry and CEIP scheduled tasks off",
      "category": "Background & Privacy",
      "group": "Telemetry",
      "order": 55,
      "level": "Advanced",
      "hint": "Disables Microsoft telemetry/CEIP tasks (Appraiser, CEIP, disk diagnostics, feedback). Small background saving; measure.",
      "description": "Disables the Microsoft Compatibility Appraiser, Customer Experience Improvement Program, Autochk proxy, disk diagnostic data collector and Feedback (SIUF) scheduled tasks. They collect compatibility and usage data in the background; the Appraiser can use CPU and disk for minutes. Tasks are disabled, never deleted, and missing ones are skipped. Revert re-enables them.",
      "evidence": {
        "tier": "B",
        "sources": [
          "https://learn.microsoft.com/en-us/windows/privacy/manage-connections-from-windows-operating-system-components-to-microsoft-services",
          "https://learn.microsoft.com/en-us/windows/whats-new/deprecated-features"
        ],
        "notes": "Microsoft documents CEIP as retired and the Appraiser as a telemetry component; the performance effect is situational, so measure."
      },
      "impact": { "performance": "low", "latency": "none", "security": "0" },
      "risk": "low",
      "antiCheat": "safe",
      "reversible": "full",
      "sideEffects": "",
      "requires": "none",
      "appliesTo": { "minBuild": 26100 },
      "hardware": { "tags": [], "excludeTags": [] },
      "source": "igwt",
      "actions": [
        {
          "type": "scheduledTask",
          "path": "\\Microsoft\\Windows\\Application Experience\\",
          "name": "Microsoft Compatibility Appraiser",
          "on": "Disabled",
          "default": "Enabled"
        },
        {
          "type": "scheduledTask",
          "path": "\\Microsoft\\Windows\\Application Experience\\",
          "name": "Microsoft Compatibility Appraiser Exp",
          "on": "Disabled",
          "default": "Enabled"
        },
        {
          "type": "scheduledTask",
          "path": "\\Microsoft\\Windows\\Customer Experience Improvement Program\\",
          "name": "Consolidator",
          "on": "Disabled",
          "default": "Enabled"
        },
        {
          "type": "scheduledTask",
          "path": "\\Microsoft\\Windows\\Customer Experience Improvement Program\\",
          "name": "UsbCeip",
          "on": "Disabled",
          "default": "Enabled"
        },
        { "type": "scheduledTask", "path": "\\Microsoft\\Windows\\Autochk\\", "name": "Proxy", "on": "Disabled", "default": "Enabled" },
        {
          "type": "scheduledTask",
          "path": "\\Microsoft\\Windows\\DiskDiagnostic\\",
          "name": "Microsoft-Windows-DiskDiagnosticDataCollector",
          "on": "Disabled",
          "default": "Enabled"
        },
        { "type": "scheduledTask", "path": "\\Microsoft\\Windows\\Feedback\\Siuf\\", "name": "DmClient", "on": "Disabled", "default": "Enabled" },
        {
          "type": "scheduledTask",
          "path": "\\Microsoft\\Windows\\Feedback\\Siuf\\",
