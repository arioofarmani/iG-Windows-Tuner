    {
      "id": "privacy.diagnostic-data-required",
      "name": "Diagnostic data: Required only",
      "category": "Background & Privacy",
      "group": "Telemetry",
      "order": 50,
      "level": "Standard",
      "hint": "Limits Windows diagnostic data to the Required level (the lowest level honored on Pro).",
      "description": "Sets the AllowTelemetry policy to 1 (Required). 'Off/Security' (0) is only honored on Enterprise, Education and Server; on Pro it behaves like Required. Optional diagnostic data and tailored-experience uploads stop. Windows Update keeps working normally.",
      "evidence": {
        "tier": "A",
        "sources": [ "https://learn.microsoft.com/en-us/windows/privacy/configure-windows-diagnostic-data-in-your-organization" ],
        "notes": "Value 0 is treated as on (equivalent to Required on Pro)."
      },
      "impact": { "performance": "none", "latency": "none", "security": "+" },
      "risk": "low",
      "antiCheat": "safe",
      "reversible": "full",
      "sideEffects": "",
      "requires": "none",
      "appliesTo": { "minBuild": 26100 },
      "hardware": { "tags": [], "excludeTags": [] },
      "source": "igwt",
      "actions": [
        {
          "type": "registry",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
          "name": "AllowTelemetry",
          "valueType": "DWord",
          "on": 1,
          "default": "<absent>",
          "equivalentOn": [ 0 ]
        }
      ]
    },
    {
      "id": "privacy.diagtrack-disabled",
      "name": "Connected User Experiences and Telemetry service off",
      "category": "Background & Privacy",
      "group": "Telemetry",
      "order": 51,
      "level": "Advanced",
      "hint": "Disables the DiagTrack service. Negligible performance effect (measure if curious); may break some Insider/feedback features.",
      "description": "Sets the DiagTrack service (Connected User Experiences and Telemetry) to Disabled and stops it. This also stops Required diagnostic data uploads, which Microsoft uses for update quality and safeguard holds. Separated from the Required-level policy because it goes beyond what Microsoft supports on Pro. Measured CPU use of DiagTrack is negligible.",
      "evidence": {
        "tier": "B",
        "sources": [ "https://learn.microsoft.com/en-us/windows-server/security/windows-services/security-guidelines-for-disabling-system-services-in-windows-server" ],
        "notes": "Microsoft lists DiagTrack as safe to disable on Windows Server with Desktop Experience; not part of any preset."
      },
      "impact": { "performance": "none", "latency": "none", "security": "0" },
      "risk": "low",
      "antiCheat": "safe",
      "reversible": "full",
      "sideEffects": "",
      "requires": "none",
      "appliesTo": { "minBuild": 26100 },
      "hardware": { "tags": [], "excludeTags": [] },
      "source": "igwt",
      "actions": [
        { "type": "service", "name": "DiagTrack", "startupType": "Disabled", "default": "Automatic", "stop": true }
      ]
    },
    {
