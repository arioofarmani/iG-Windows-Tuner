    {
      "id": "power.fast-startup-off",
      "name": "Fast Startup off",
      "category": "Power & CPU",
      "group": "Boot",
      "order": 30,
      "level": "Standard",
      "hint": "Shutdown performs a full kernel and driver restart instead of hibernating the kernel session.",
      "description": "Sets HiberbootEnabled to 0. With Fast Startup, 'Shut down' hibernates the kernel session, so drivers and the kernel are never freshly initialized until a Restart. Turning it off gives a clean driver state at every boot and avoids stale driver issues. Trade-off: cold boots take a few seconds longer.",
      "evidence": {
        "tier": "A",
        "sources": [ "https://learn.microsoft.com/en-us/windows-hardware/drivers/kernel/distinguishing-fast-startup-from-wake-from-hibernation" ],
        "notes": "When hibernation is disabled, Fast Startup is unavailable anyway; the value is still set for consistency."
      },
      "impact": { "performance": "none", "latency": "none", "security": "0" },
      "risk": "low",
      "antiCheat": "safe",
      "reversible": "full",
      "sideEffects": "",
      "requires": "none",
      "appliesTo": { "minBuild": 26100 },
      "editions": [],
      "hardware": { "tags": [], "excludeTags": [] },
      "scope": "Performance",
      "managedBy": [ "local" ],
      "gpoPath": "",
      "admxRef": null,
      "requiresDomain": false,
      "requiresMdm": false,
      "source": "igwt",
      "actions": [
        {
          "type": "registry",
          "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power",
          "name": "HiberbootEnabled",
          "valueType": "DWord",
          "on": 0,
          "default": 1,
          "absentValue": 1
        }
      ]
    },
    {
      "id": "power.hibernation-off",
      "name": "Hibernation off",
      "category": "Power & CPU",
      "group": "Boot",
      "order": 31,
      "level": "Advanced",
      "hint": "Turns off hibernation and deletes hiberfil.sys. Nothing to measure: it frees disk space, not FPS. Only if you never hibernate.",
      "description": "Runs powercfg /hibernate off, which removes hiberfil.sys (often several GB) and also disables Fast Startup. This is a disk-space and boot-consistency change, not a performance change, so there is nothing to measure before/after. Do not use it if you rely on Hibernate.",
      "evidence": {
        "tier": "B",
        "sources": [
          "https://learn.microsoft.com/en-us/troubleshoot/windows-client/setup-upgrade-and-drivers/disable-and-re-enable-hibernation",
          "https://learn.microsoft.com/en-us/windows-hardware/design/device-experiences/powercfg-command-line-options"
        ],
        "notes": "Situational: only useful when hibernation is unused."
      },
      "impact": { "performance": "none", "latency": "none", "security": "0" },
      "risk": "low",
      "antiCheat": "safe",
      "reversible": "full",
      "sideEffects": "",
      "requires": "none",
      "appliesTo": { "minBuild": 26100 },
      "editions": [],
      "hardware": { "tags": [], "excludeTags": [] },
      "scope": "Performance",
      "managedBy": [ "local" ],
      "gpoPath": "",
      "admxRef": null,
      "requiresDomain": false,
      "requiresMdm": false,
      "source": "igwt",
      "actions": [
        { "type": "custom", "handler": "Hibernate" }
      ]
    },
    {
      "id": "power.power-throttling-on",
      "name": "Keep Power Throttling on (hybrid CPU)",
      "category": "Power & CPU",
      "group": "Scheduler",
      "order": 32,
      "level": "Standard",
      "hint": "Removes the 'PowerThrottlingOff' override some tools set. Throttling moves background work to E-cores, away from your game.",
      "description": "Ensures HKLM\\...\\Power\\PowerThrottling\\PowerThrottlingOff is not set to 1. On hybrid Intel CPUs, Power Throttling (EcoQoS) lets Windows and Thread Director steer background processes onto efficiency cores, leaving performance cores to the foreground game. Disabling it is a popular but counter-productive tweak.",
      "evidence": {
        "tier": "A",
        "sources": [
          "https://learn.microsoft.com/en-us/windows/win32/procthread/quality-of-service",
          "https://blogs.windows.com/windows-insider/2017/04/18/introducing-power-throttling/"
        ],
        "notes": "Repair-only: value absent (the Windows default) or 0 counts as on."
      },
      "impact": { "performance": "low", "latency": "low", "security": "0" },
      "risk": "low",
      "antiCheat": "safe",
      "reversible": "full",
      "sideEffects": "",
      "requires": "reboot",
      "appliesTo": { "minBuild": 26100 },
      "editions": [],
      "hardware": { "tags": [], "excludeTags": [] },
      "scope": "Performance",
      "managedBy": [ "local" ],
      "gpoPath": "",
      "admxRef": null,
      "requiresDomain": false,
      "requiresMdm": false,
      "source": "igwt",
      "actions": [
        {
          "type": "registry",
          "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Power\\PowerThrottling",
          "name": "PowerThrottlingOff",
          "valueType": "DWord",
          "on": "<absent>",
          "default": "<absent>",
          "equivalentOn": [ 0 ]
        }
      ]
    },
    {
