      "editions": [],
      "hardware": { "tags": [], "excludeTags": [] },
      "scope": "Performance",
      "managedBy": [ "local" ],
      "gpoPath": "",
      "admxRef": null,
      "requiresDomain": false,
      "requiresMdm": false,
      "source": "igwt",
      "conflictsWith": [ "power.ultimate-plan" ],
      "actions": [
        { "type": "powercfgScheme", "scheme": "8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c" }
      ]
    },
    {
      "id": "power.usb-selective-suspend-off",
      "name": "USB selective suspend off",
      "category": "Power & CPU",
      "group": "Power plan settings",
      "order": 20,
      "level": "Standard",
      "hint": "Stops Windows from suspending idle USB ports, preventing mouse, headset and DAC dropouts. Plugged-in (AC) setting only.",
      "description": "Sets the active plan's 'USB selective suspend setting' to Disabled on AC power. Selective suspend powers down idle USB devices; on some hubs and audio interfaces this causes wake-up delays or dropouts. Applies to the plan that is active at apply time.",
      "evidence": {
        "tier": "A",
        "sources": [
          "https://learn.microsoft.com/en-us/windows-hardware/drivers/usbcon/usb-selective-suspend",
          "https://learn.microsoft.com/en-us/windows-hardware/design/device-experiences/powercfg-command-line-options"
        ],
        "notes": "Subgroup 2a737441-1930-4402-8d77-b2bebba308a3, setting 48e6b7a6-50f5-4782-a5d4-53bb8f07e226."
      },
      "impact": { "performance": "none", "latency": "low", "security": "0" },
      "risk": "low",
      "antiCheat": "safe",
      "reversible": "full",
      "sideEffects": "",
      "requires": "none",
      "appliesTo": { "minBuild": 26100 },
      "editions": [],
      "hardware": { "tags": [], "excludeTags": [] },
      "scope": "Performance",
      "managedBy": [ "local" ],
      "gpoPath": "",
      "admxRef": null,
      "requiresDomain": false,
      "requiresMdm": false,
      "source": "igwt",
      "actions": [
        {
          "type": "powercfgSetting",
          "label": "USB selective suspend",
          "subgroup": "2a737441-1930-4402-8d77-b2bebba308a3",
          "setting": "48e6b7a6-50f5-4782-a5d4-53bb8f07e226",
          "ac": 0,
          "defaultFromScheme": "8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c",
          "defaultAc": 1
        }
      ]
