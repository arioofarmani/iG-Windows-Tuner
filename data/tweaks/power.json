      "scope": "Performance",
      "managedBy": [ "local" ],
      "gpoPath": "",
      "admxRef": null,
      "requiresDomain": false,
      "requiresMdm": false,
      "source": "igwt",
      "actions": [
        {
          "type": "powercfgSetting",
          "label": "PCIe Link State Power Management",
          "subgroup": "501a4d13-42af-4429-9fd1-a8218c268e20",
          "setting": "ee12f906-d277-404b-b6da-e5fa1a576df5",
          "ac": 0,
          "defaultFromScheme": "381b4222-f694-41f0-9685-ff5bb260df2e",
          "defaultAc": 1
        }
