    {
      "id": "power.pcie-aspm-off",
      "name": "PCI Express Link State Power Management off",
      "category": "Power & CPU",
      "group": "Power plan settings",
      "order": 20,
      "level": "Standard",
      "hint": "Keeps PCIe links (GPU, NVMe, NIC) at full power instead of entering low-power states on AC power.",
      "description": "Sets the active plan's PCI Express 'Link State Power Management' (ASPM) to Off on AC power. ASPM saves power by putting idle PCIe links into L0s/L1, and waking them adds latency. Trade-off: a few watts of idle power. BIOS ASPM settings still apply.",
      "evidence": {
        "tier": "A",
        "sources": [
          "https://learn.microsoft.com/en-us/windows-hardware/customize/power-settings/pci-express-settings-link-state-power-management",
          "https://learn.microsoft.com/en-us/windows-hardware/design/device-experiences/powercfg-command-line-options"
        ],
        "notes": "SUB_PCIEXPRESS 501a4d13-42af-4429-9fd1-a8218c268e20 / ASPM ee12f906-d277-404b-b6da-e5fa1a576df5."
      },
      "impact": { "performance": "none", "latency": "low", "security": "0" },
      "risk": "low",
      "antiCheat": "safe",
      "reversible": "full",
      "sideEffects": "",
      "requires": "none",
