  "tweaks": [
    {
      "id": "power.ultimate-plan",
      "name": "Ultimate Performance power plan",
      "category": "Power & CPU",
      "group": "Power plan",
      "order": 10,
      "level": "Advanced",
      "hint": "Activates the Ultimate Performance plan (High performance minus remaining power-saving timers). Raises idle power. Measure.",
      "description": "Duplicates the hidden Ultimate Performance scheme (e9a42b02-...) once, or reuses a copy that already exists, and makes it the active plan. Microsoft built it for high-end desktops to eliminate micro-latencies from fine-grained power management. CPU C-states and turbo remain under BIOS control. Trade-off: higher idle power and heat; the gain over High performance is small, so measure frametimes before and after.",
      "evidence": {
        "tier": "B",
        "sources": [ "https://learn.microsoft.com/en-us/windows-hardware/design/device-experiences/powercfg-command-line-options" ],
        "notes": "Inbox Microsoft scheme (resource text: 'Provides ultimate performance on higher end PCs'), duplicated with the documented powercfg /duplicatescheme. Microsoft's 2018 announcement post is no longer online, so it is Tier B. iG Windows Tuner never changes C-state or processor power settings inside the plan."
      },
      "impact": { "performance": "low", "latency": "low", "security": "0" },
      "risk": "low",
      "antiCheat": "safe",
      "reversible": "full",
      "sideEffects": "",
      "requires": "none",
      "appliesTo": { "minBuild": 26100 },
      "editions": [],
      "hardware": { "tags": [], "excludeTags": [] },
      "scope": "Performance",
      "managedBy": [ "local" ],
      "gpoPath": "",
      "admxRef": null,
      "requiresDomain": false,
      "requiresMdm": false,
      "source": "igwt",
      "conflictsWith": [ "power.high-performance-plan" ],
      "revertNote": "Revert re-activates your previous plan and deletes the Ultimate copy only if iG Windows Tuner created it.",
      "actions": [
        { "type": "custom", "handler": "UltimatePlan" }
      ]
    },
    {
      "id": "power.high-performance-plan",
      "name": "High performance power plan",
      "category": "Power & CPU",
      "group": "Power plan",
      "order": 10,
      "level": "Standard",
      "hint": "Activates the built-in High performance plan (faster clock ramp-up than Balanced). Slightly higher idle power.",
      "description": "Makes the inbox High performance scheme (8c5e7fda-...) active. Compared with Balanced, the CPU ramps clocks up faster and devices idle less aggressively. Thread Director and the Windows scheduler still decide which cores run your game. Trade-off: slightly higher idle power.",
      "evidence": {
        "tier": "A",
        "sources": [ "https://learn.microsoft.com/en-us/windows-hardware/design/device-experiences/powercfg-command-line-options" ],
        "notes": "Inbox power scheme."
      },
      "impact": { "performance": "low", "latency": "low", "security": "0" },
      "risk": "low",
      "antiCheat": "safe",
      "reversible": "full",
      "sideEffects": "",
      "requires": "none",
