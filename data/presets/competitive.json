{
  "schemaVersion": 2,
  "id": "competitive",
  "name": "Competitive",
  "order": 1,
  "tagline": "Maximum performance, lowest latency",
  "hint": "Maximum performance and lowest latency: every Tier A item plus situational Tier B latency tweaks. Anti-cheat safe.",
  "description": "Every Tier A performance, input and network item plus the Tier B latency items (Ultimate Performance plan, HAGS, MMCSS, adapter power saving, interrupt moderation, DSCP marking, per-game GPU, unused Wi-Fi off). The security baseline stays fully on: Defender, VBS/HVCI, ASR baseline, LSA protection, firewall. Nothing that anti-cheat needs is touched.",
  "gaming": true,
  "levelCeiling": "Advanced",
  "antiCheatPolicy": "safeOnly",
  "include": [
    "power.ultimate-plan",
    "power.usb-selective-suspend-off",
    "power.pcie-aspm-off",
    "power.fast-startup-off",
    "power.hibernation-off",
    "power.power-throttling-on",
    "sched.system-responsiveness",
    "sched.network-throttling-off",
    "gfx.game-mode",
    "gfx.background-recording-off",
    "gfx.windowed-optimizations",
    "gfx.vrr-optimizations",
    "gfx.hags",
    "gfx.gpu-preference-games",
    "input.pointer-precision-off",
    "input.accessibility-hotkeys-off",
    "net.adapter-power-saving-off",
    "net.eee-off",
    "net.rss-on",
    "net.tcp-autotuning-normal",
    "net.interrupt-moderation-off",
    "net.qos-dscp-games",
    "net.wifi-disable",
    "net.delivery-optimization-p2p-off",
    "privacy.diagnostic-data-required",
    "privacy.ads-suggestions-off",
    "privacy.widgets-off",
    "privacy.edge-background-off",
    "privacy.update-active-hours",
    "privacy.keep-drivers",
    "privacy.background-apps-off",
    "privacy.reduce-visual-effects",
    "sec.hvci-on",
    "sec.vulnerable-driver-blocklist",
    "sec.lsa-protection",
    "sec.defender-hardening",
    "sec.network-protection",
    "sec.gaming-friendly-scans",
    "sec.asr-baseline",
    "sec.uac-on",
    "sec.autorun-off",
    "sec.smb-hardening",
    "sec.firewall-on",
    "sec.smartscreen-on"
  ],
  "exclude": []
}
