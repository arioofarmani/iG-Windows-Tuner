{
  "schemaVersion": 3,
  "id": "laptop",
  "name": "Laptop Gamer",
  "version": "3.6.0",
  "order": 6,
  "code": "L",
  "tagline": "Fast on AC, efficient on battery",
  "hint": "Gaming tweaks that do not cost battery life: Windows power plans and throttling stay in charge, Wi-Fi at full power only on AC.",
  "description": "For gaming laptops. The power plan, PCIe and USB power saving, EEE and hibernation stay at Windows defaults so battery life is unchanged; Power Throttling stays on and the Ultimate plan is never used. Games are pinned to the dedicated GPU, Wi-Fi runs at maximum performance only when plugged in, and the gaming, privacy and security items match Balanced. Driver updates from Windows Update stay on, because laptop vendors ship firmware and power drivers that way.",
  "gaming": true,
  "levelCeiling": "Advanced",
  "antiCheatPolicy": "safeOnly",
  "firewallScope": "public-wifi-laptop",
  "guidance": [
    "Use the power mode slider (Settings > System > Power & battery): Best performance on AC, Balanced or Best power efficiency on battery.",
    "Plug in for competitive play: on battery, Windows and the GPU driver lower clocks by design.",
    "If your laptop has a MUX switch or a dGPU-only mode in the vendor app, use it for the lowest latency."
  ],
  "requires": { "minBuild": 26100 },
  "changes": [
    { "item": "power.fast-startup-off", "desired": "on" },
    { "item": "power.power-throttling-on", "desired": "on" },
    { "item": "gfx.game-mode", "desired": "on" },
    { "item": "gfx.background-recording-off", "desired": "on" },
    { "item": "gfx.windowed-optimizations", "desired": "on" },
    { "item": "gfx.vrr-optimizations", "desired": "on" },
    { "item": "gfx.gpu-preference-games", "desired": "on" },
    { "item": "input.pointer-precision-off", "desired": "on" },
    { "item": "input.accessibility-hotkeys-off", "desired": "on" },
    { "item": "net.wifi-power-max-performance", "desired": "on" },
    { "item": "net.rss-on", "desired": "on" },
    { "item": "net.tcp-autotuning-normal", "desired": "on" },
    { "item": "net.delivery-optimization-p2p-off", "desired": "on" },
    { "item": "privacy.diagnostic-data-required", "desired": "on" },
    { "item": "privacy.ads-suggestions-off", "desired": "on" },
    { "item": "privacy.widgets-off", "desired": "on" },
    { "item": "privacy.edge-background-off", "desired": "on" },
    { "item": "privacy.update-active-hours", "desired": "on" },
    { "item": "sec.hvci-on", "desired": "on" },
    { "item": "sec.vulnerable-driver-blocklist", "desired": "on" },
    { "item": "sec.lsa-protection", "desired": "on" },
    { "item": "sec.defender-hardening", "desired": "on" },
    { "item": "sec.network-protection", "desired": "on" },
    { "item": "sec.gaming-friendly-scans", "desired": "on" },
    { "item": "sec.asr-baseline", "desired": "on" },
    { "item": "sec.asr-office-audit", "desired": "on" },
    { "item": "sec.uac-on", "desired": "on" },
    { "item": "sec.llmnr-off", "desired": "on" },
    { "item": "sec.autorun-off", "desired": "on" },
    { "item": "sec.smb-hardening", "desired": "on" },
    { "item": "sec.firewall-on", "desired": "on" },
    { "item": "sec.smartscreen-on", "desired": "on" },
    { "item": "power.high-performance-plan", "desired": "unchanged" },
    { "item": "power.ultimate-plan", "desired": "unchanged" },
    { "item": "power.pcie-aspm-off", "desired": "unchanged" },
    { "item": "power.usb-selective-suspend-off", "desired": "unchanged" },
    { "item": "power.hibernation-off", "desired": "unchanged" },
    { "item": "net.eee-off", "desired": "unchanged" },
    { "item": "privacy.keep-drivers", "desired": "unchanged" }
  ],
