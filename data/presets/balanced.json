{
  "schemaVersion": 2,
  "id": "balanced",
  "name": "Balanced",
  "order": 2,
  "tagline": "Recommended daily driver",
  "hint": "Recommended daily driver: every Tier A performance, security and privacy item, and nothing situational.",
  "description": "All Tier A performance items plus all Tier A security and privacy items. No Tier B (situational) changes, so nothing here needs before/after measurement to justify it.",
  "gaming": true,
  "levelCeiling": "Advanced",
  "antiCheatPolicy": "safeOnly",
  "include": [
    "power.high-performance-plan",
    "power.usb-selective-suspend-off",
    "power.pcie-aspm-off",
    "power.fast-startup-off",
    "power.power-throttling-on",
    "gfx.game-mode",
    "gfx.background-recording-off",
    "gfx.windowed-optimizations",
    "gfx.vrr-optimizations",
    "input.pointer-precision-off",
    "input.accessibility-hotkeys-off",
    "net.eee-off",
    "net.rss-on",
    "net.tcp-autotuning-normal",
    "net.delivery-optimization-p2p-off",
    "privacy.diagnostic-data-required",
    "privacy.ads-suggestions-off",
    "privacy.widgets-off",
    "privacy.edge-background-off",
    "privacy.update-active-hours",
    "privacy.keep-drivers",
    "sec.hvci-on",
    "sec.vulnerable-driver-blocklist",
    "sec.lsa-protection",
    "sec.defender-hardening",
    "sec.network-protection",
    "sec.gaming-friendly-scans",
    "sec.asr-baseline",
    "sec.asr-office-audit",
    "sec.uac-on",
    "sec.llmnr-off",
    "sec.autorun-off",
    "sec.smb-hardening",
    "sec.firewall-on",
    "sec.smartscreen-on"
  ],
  "exclude": []
}
