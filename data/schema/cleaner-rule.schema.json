{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://igwindowstuner.local/schema/cleaner-rule.schema.json",
  "title": "iG Windows Tuner cleaner rule file (schema v2)",
  "type": "object",
  "required": [ "schemaVersion", "rules" ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "category": { "type": "string" },
    "rules": { "type": "array", "items": { "$ref": "#/definitions/rule" } }
  },
  "definitions": {
    "rule": {
      "type": "object",
      "required": [ "id", "name", "category", "level", "tier", "method", "hint", "description", "sideEffects", "antiCheat", "reversible", "source", "hardware" ],
      "properties": {
        "id": { "type": "string", "pattern": "^clean\\.[a-z0-9\\.\\-]+$" },
        "name": { "type": "string" },
        "category": { "enum": [ "System", "Gaming", "Browsers", "Apps", "Developer", "Downloads" ] },
        "level": { "enum": [ "Standard", "Advanced", "Expert" ] },
        "tier": { "enum": [ "A", "B" ], "description": "A: the location or method is documented by Microsoft or the vendor (see sources). B: a well-known cache location without a vendor document." },
        "method": { "enum": [ "files", "browserCache", "recycleBin", "deliveryOptimization", "dism", "driverStore", "guidance" ] },
        "default": { "type": "boolean", "description": "Selected by default (Standard rules only)." },
        "hint": { "type": "string", "minLength": 1, "maxLength": 140 },
        "description": { "type": "string", "minLength": 40 },
        "sideEffects": { "type": "string" },
        "antiCheat": { "const": "safe" },
        "reversible": { "enum": [ "full", "partial", "none" ], "description": "none: deleted permanently; partial: Recycle Bin; full: nothing is changed (guidance)." },
        "source": { "enum": [ "igwt", "winutil", "microsoft" ] },
        "attribution": { "type": "string" },
        "hardware": { "type": "object", "properties": { "tags": { "type": "array", "items": { "type": "string" } }, "excludeTags": { "type": "array", "items": { "type": "string" } } } },
        "requiresAdmin": { "type": "boolean" },
        "roots": { "type": "array", "items": { "type": "string" }, "description": "Folders the rule may clean: environment variables, {SteamLibrary}." },
        "browser": { "enum": [ "chromium", "firefox" ] },
        "userDataRoots": { "type": "array", "items": { "type": "string" } },
        "profileCacheDirs": { "type": "array", "items": { "type": "string" } },
        "rootCacheDirs": { "type": "array", "items": { "type": "string" } },
        "include": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } },
        "recurse": { "type": "boolean" },
        "minAgeHours": { "type": "number", "minimum": 0 },
        "keepNewest": { "type": "integer", "minimum": 0 },
        "recycle": { "type": "boolean" },
        "allowDownloads": { "type": "boolean" },
        "allowSystemFiles": { "type": "boolean" },
        "removeEmptyDirs": { "type": "boolean" },
        "requiresClosed": { "type": "array", "items": { "type": "string" } },
        "services": { "type": "array", "items": { "type": "string" } },
        "allUsers": { "type": "boolean" },
        "resetBase": { "type": "boolean" },
        "notes": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string", "pattern": "^https://" } }
      }
    }
  }
}
