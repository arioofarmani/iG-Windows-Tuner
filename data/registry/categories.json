{
  "schemaVersion": 1,
  "kind": "regCleanCategories",
  "description": "Registry cleaner categories (DECISIONS RG1, RG3, RG10, RG16, RG32). roots: the keys a category may scan and remove below; a target equal to a root is never removable. view 64 = Registry64, 32 = Registry32 (the WOW6432Node view, addressed through RegistryView, not the literal path); HKCU is read once (shared key). maxConfidence: the highest confidence the category can ever show. kind: what a removal of one finding is (regKeyTree, regValue, firewallRule, reportOnly = never removed by iG).",
  "categories": [
    {
      "id": "uninstall",
      "kind": "regKeyTree",
      "maxConfidence": "Safe",
      "roots": [
        { "hive": "HKLM", "view": "64", "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall" },
        { "hive": "HKLM", "view": "32", "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall" },
        { "hive": "HKCU", "view": "64", "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall" }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/win32/msi/uninstall-registry-key",
        "https://learn.microsoft.com/en-us/windows/win32/winprog64/registry-redirector"
      ]
    },
    {
