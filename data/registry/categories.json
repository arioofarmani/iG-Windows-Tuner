      "maxConfidence": "Safe",
      "roots": [
        { "hive": "HKLM", "view": "64", "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths" },
        { "hive": "HKCU", "view": "64", "path": "Software\\Microsoft\\Windows\\CurrentVersion\\App Paths" }
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/win32/shell/app-registration",
