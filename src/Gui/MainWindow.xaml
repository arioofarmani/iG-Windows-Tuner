<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iG Windows Tuner" Width="1280" Height="820" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BrushBackground}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{DynamicResource FontUi}" FontSize="{DynamicResource FontSizeBody}"
        BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1">
    <!-- Custom title bar in the app theme (the header is the caption area; no P/Invoke) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" GlassFrameThickness="0" UseAeroCaptionButtons="False" ResizeBorderThickness="6" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <!-- Theme.xaml is merged here by Gui.ps1 before the window is parsed. -->
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="RootGrid" TextElement.Foreground="{DynamicResource BrushText}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BrushSidebar}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource BrushAccentSoft}" Margin="0,0,12,0"><TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="20" Foreground="{DynamicResource BrushAccent}" HorizontalAlignment="Center"/></Border>
                    <StackPanel>
                        <TextBlock Text="iG Windows Tuner" FontSize="{DynamicResource FontSizeTitleSmall}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HeaderVersion" Style="{StaticResource TextMuted}" Text="Gaming performance and security toolbox"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,-12,-18,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="CaptionMinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
                    <Button x:Name="CaptionMaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize" AutomationProperties.Name="Maximize"/>
                    <Button x:Name="CaptionCloseButton" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" ToolTip="Close" AutomationProperties.Name="Close"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="DisplayButton" Style="{StaticResource GhostButton}" ToolTip="Display: theme, text size, density and motion" AutomationProperties.Name="Display settings" Padding="8,6">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE790;"/>
                    </Button>
                    <Popup x:Name="DisplayPopup" PlacementTarget="{Binding ElementName=DisplayButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Style="{StaticResource PopupPanel}" Width="300">
                            <StackPanel>
                                <TextBlock Text="Display" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Style="{StaticResource TextCaption}" Text="Theme" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ThemeBox" Margin="0,0,0,10" AutomationProperties.Name="Theme" ToolTip="System follows the Windows app mode and high contrast."/>
                                <TextBlock Style="{StaticResource TextCaption}" Text="Text size" Margin="0,0,0,4"/>
                                <ComboBox x:Name="FontScaleBox" Margin="0,0,0,10" AutomationProperties.Name="Text size" ToolTip="Size of all text in the window (100 to 150 %)."/>
                                <TextBlock Style="{StaticResource TextCaption}" Text="Density" Margin="0,0,0,4"/>
                                <ComboBox x:Name="DensityBox" Margin="0,0,0,10" AutomationProperties.Name="Density" ToolTip="Compact shows more rows; Comfortable is easier to read."/>
                                <DockPanel Margin="0,4,0,0">
                                    <CheckBox x:Name="ReduceMotionBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="Reduce motion" ToolTip="No transitions or moving elements. On automatically when Windows animation effects are off." VerticalAlignment="Center"/>
                                    <TextBlock Text="Reduce motion" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource TextCaption}" Text="Saved for this Windows user. Nothing on the PC changes." TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <ComboBox x:Name="PersonaBox" Width="150" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Persona: changes the navigation order and which item levels are shown. Safety rules are the same for every persona."/>
                    <Border x:Name="AcPill" CornerRadius="12" Padding="10,3" Margin="0,0,8,0" Background="{DynamicResource BrushSurfaceAlt}" ToolTip="Anti-cheat readiness (TPM, Secure Boot, VBS, HVCI, IOMMU). Open the Dashboard for details.">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="AcPillDot" Width="9" Height="9" Fill="{DynamicResource BrushTextMuted}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AcPillText" Text="Anti-cheat: checking..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="AdminBadge" CornerRadius="12" Padding="10,3" Margin="0,0,8,0" Background="{DynamicResource BrushSurfaceAlt}">
                        <TextBlock x:Name="AdminText" Text="Read-only" VerticalAlignment="Center"/>
                    </Border>
                    <Button x:Name="ElevateButton" Content="Restart as administrator" ToolTip="Relaunch iG Windows Tuner elevated through the normal UAC prompt so changes can be applied." Margin="0"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="24,0,12,0">
                    <TextBlock x:Name="HeaderSummary" Text="Detecting hardware..." TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HeaderBuild" Style="{StaticResource TextMuted}" Text="" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="1">
            <!-- Read-only mode (started with -ReadOnly, or not elevated) -->
            <Border x:Name="ReadOnlyBanner" AutomationProperties.AutomationId="ReadOnlyBanner" AutomationProperties.Name="Read-only mode" Visibility="Collapsed" Background="{DynamicResource BrushAccentSoft}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="0,0,0,1" Padding="18,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE72E;" Foreground="{DynamicResource BrushAccent}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ReadOnlyBannerText" Text="Read-only mode" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <!-- Persistent restart / information banner -->
            <Border x:Name="Banner" Visibility="Collapsed" Background="{DynamicResource BrushWarningSoft}" BorderBrush="{DynamicResource BrushWarning}" BorderThickness="0,0,0,1" Padding="18,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource BrushWarning}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="BannerText" Text="" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <!-- Error boundary: an error inside the window shows here instead of closing it -->
            <Border x:Name="ErrorBar" AutomationProperties.AutomationId="ErrorBar" Visibility="Collapsed" Background="{DynamicResource BrushDangerSoft}" BorderBrush="{DynamicResource BrushDanger}" BorderThickness="0,0,0,1" Padding="18,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xEA39;" Foreground="{DynamicResource BrushDanger}" Margin="0,0,10,0"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ErrorCopyButton" Content="Copy details" ToolTip="Copy the full error to the clipboard."/>
                        <Button x:Name="ErrorDismissButton" Content="Dismiss" Margin="0" ToolTip="Hide this message (it is kept in the log)."/>
                    </StackPanel>
                    <TextBlock x:Name="ErrorText" Text="" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="DetailsColumn" Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Left navigation -->
            <Border Grid.Column="0" Background="{DynamicResource BrushSidebar}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0" Padding="0,10">
                <ListBox x:Name="NavList" ItemContainerStyle="{StaticResource NavItem}" KeyboardNavigation.TabNavigation="Once" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="False" AutomationProperties.Name="Navigation">
                    <ListBoxItem Tag="Dashboard" AutomationProperties.Name="Dashboard" ToolTip="Health checks and anti-cheat readiness (read-only)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" Margin="0,0,12,0"/><TextBlock Text="Dashboard"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Presets" AutomationProperties.Name="Presets" ToolTip="Competitive, Balanced and Hardened presets">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" Margin="0,0,12,0"/><TextBlock Text="Presets"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Power &amp; CPU" AutomationProperties.Name="Power &amp; CPU" ToolTip="Power plans, USB/PCIe power, scheduler">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" Margin="0,0,12,0"/><TextBlock Text="Power &amp; CPU"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Graphics &amp; Display" AutomationProperties.Name="Graphics &amp; Display" ToolTip="Game Mode, capture, presentation, HAGS">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" Margin="0,0,12,0"/><TextBlock Text="Graphics &amp; Display"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Input" AutomationProperties.Name="Input" ToolTip="Mouse acceleration, accessibility hotkeys, key repeat">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE765;" Margin="0,0,12,0"/><TextBlock Text="Input"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Network" AutomationProperties.Name="Network" ToolTip="Wired adapter, TCP/IP, QoS, DNS">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE839;" Margin="0,0,12,0"/><TextBlock Text="Network"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Background &amp; Privacy" AutomationProperties.Name="Background &amp; Privacy" ToolTip="Telemetry, suggestions, Windows Update behavior, services">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" Margin="0,0,12,0"/><TextBlock Text="Background &amp; Privacy"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Security" AutomationProperties.Name="Security" ToolTip="VBS/HVCI, Defender, firewall and hardening items; the ASR Center and the Defender settings are part of Security">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Margin="0,0,12,0"/><TextBlock Text="Security"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Asr" AutomationProperties.Name="Asr" ToolTip="Security > ASR Center: attack surface reduction rules, modes, gamer impact, exclusions and the audit view">
                        <StackPanel Orientation="Horizontal" Margin="28,0,0,0"><TextBlock Style="{StaticResource Icon}" Text="&#xE83D;" FontSize="14" Margin="0,0,10,0" Foreground="{DynamicResource BrushTextMuted}"/><TextBlock Text="ASR Center" FontSize="{DynamicResource FontSizeSmall}"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Defender" AutomationProperties.Name="Defender" ToolTip="Security > Defender settings: every Microsoft Defender Antivirus setting, also the hidden ones, and every Defender Group Policy">
                        <StackPanel Orientation="Horizontal" Margin="28,0,0,0"><TextBlock Style="{StaticResource Icon}" Text="&#xE9E9;" FontSize="14" Margin="0,0,10,0" Foreground="{DynamicResource BrushTextMuted}"/><TextBlock Text="Defender settings" FontSize="{DynamicResource FontSizeSmall}"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Firewall" AutomationProperties.Name="Firewall" ToolTip="Security > Firewall: every firewall rule with risk views, safe rule actions, the new-rule wizard and the profiles">
                        <StackPanel Orientation="Horizontal" Margin="28,0,0,0"><TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="14" Margin="0,0,10,0" Foreground="{DynamicResource BrushTextMuted}"/><TextBlock Text="Firewall" FontSize="{DynamicResource FontSizeSmall}"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="System" AutomationProperties.Name="System" ToolTip="Page file, crash dumps and boot diagnostics">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7EF;" Margin="0,0,12,0"/><TextBlock Text="System &amp; Diagnostics"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Policy" AutomationProperties.Name="Policy" ToolTip="Every Group Policy setting of the installed administrative templates, with its state; set the ones that are safe">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Margin="0,0,12,0"/><TextBlock Text="Group Policy"/></StackPanel>
                    </ListBoxItem>                    <ListBoxItem Tag="Risk Zone" AutomationProperties.Name="Risk Zone" ToolTip="Rejected tweaks you can apply at your own risk, each with its warnings and what it turns off or on">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Margin="0,0,12,0" Foreground="{DynamicResource BrushDanger}"/><TextBlock Text="Risk Zone" Foreground="{DynamicResource BrushDanger}"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Inspect" AutomationProperties.Name="Inspect" ToolTip="Read-only expert inspectors: power plan, interrupts, network queues, kernel and memory, crash dumps">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Margin="0,0,12,0"/><TextBlock Text="Expert Inspectors"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Manage" AutomationProperties.Name="Manage" ToolTip="Services, scheduled tasks, apps, the persistence inspector and the firewall rule browser">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE912;" Margin="0,0,12,0"/><TextBlock Text="Manage"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Toolkit" AutomationProperties.Name="Toolkit" ToolTip="Install apps with winget, Windows features, previewed repair fixes, classic panels and Windows Update options (inspired by WinUtil)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" Margin="0,0,12,0"/><TextBlock Text="Toolkit"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Diagnostics" AutomationProperties.Name="Diagnostics" ToolTip="DPC/ISR, reliability, crashes, boot time, drivers, Windows Update, network tools and the system report">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" Margin="0,0,12,0"/><TextBlock Text="Diagnostics &amp; Network"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="NetTest" AutomationProperties.Name="NetTest" ToolTip="Measure latency, jitter, packet loss and stability, detect your connection type and get the best network adjustments">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE701;" Margin="0,0,12,0"/><TextBlock Text="Network Test"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Cleaner" AutomationProperties.Name="Cleaner" ToolTip="Scan, then clean temp files, caches and logs with allow-list rules">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,12,0"/><TextBlock Text="Cleaner"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Storage" AutomationProperties.Name="Storage" ToolTip="Windows Storage Sense policies (automatic cleanup by Windows itself)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" Margin="0,0,12,0"/><TextBlock Text="Storage Sense"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Disk" AutomationProperties.Name="Disk" ToolTip="Largest folders and files on a drive (read-only)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,12,0"/><TextBlock Text="Disk Analyzer"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Startup" AutomationProperties.Name="Startup" ToolTip="Programs that start with Windows (StartupApproved, never deleted)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Margin="0,0,12,0"/><TextBlock Text="Startup Apps"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Backups" AutomationProperties.Name="Backups" ToolTip="Snapshots, revert and logs">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Margin="0,0,12,0"/><TextBlock Text="Backups &amp; Logs"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Rejected" AutomationProperties.Name="Rejected" ToolTip="Popular tweaks iG Windows Tuner deliberately does not implement, and why">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE711;" Margin="0,0,12,0"/><TextBlock Text="Rejected Tweaks"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="About" AutomationProperties.Name="About" ToolTip="What iG Windows Tuner does and does not do">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,12,0"/><TextBlock Text="About"/></StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <!-- Pages -->
            <Grid Grid.Column="1" Margin="20,14,12,8">

                <!-- Dashboard: four status tiles, one short action list, details folded away -->
                <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Margin="0,0,10,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="RefreshButton" Content="Refresh" ToolTip="Re-read the real system state (read-only)."/>
                                <Button x:Name="ExportReportButton" Content="Export HTML report" ToolTip="Save the health report as a self-contained HTML file and open it." Margin="0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource TextTitle}" Text="Your PC at a glance"/>
                                <TextBlock x:Name="DashSubtitle" Style="{StaticResource TextMuted}" FontSize="{DynamicResource FontSizeBody}" Text="Read-only. Press Refresh to read the live system."/>
                            </StackPanel>
                        </DockPanel>

                        <UniformGrid Columns="4" Margin="0,18,0,0">
                            <Border x:Name="DashTileAc" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Border x:Name="DashAcDisc" Style="{StaticResource IconDisc}" Margin="0,0,10,0"><TextBlock x:Name="DashAcIcon" Style="{StaticResource Icon}" Text="&#xE7FC;" HorizontalAlignment="Center"/></Border>
                                        <TextBlock Style="{StaticResource TextOverline}" Text="ANTI-CHEAT" Margin="0" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="DashAcValue" Style="{StaticResource TextKpi}" Text="..."/>
                                    <TextBlock x:Name="DashAcNote" Style="{StaticResource TextMuted}" Margin="0,4,0,0" Text="Checking requirements"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="DashTileSec" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Border x:Name="DashSecDisc" Style="{StaticResource IconDisc}" Margin="0,0,10,0"><TextBlock x:Name="DashSecIcon" Style="{StaticResource Icon}" Text="&#xEA18;" HorizontalAlignment="Center"/></Border>
                                        <TextBlock Style="{StaticResource TextOverline}" Text="SECURITY" Margin="0" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="DashSecValue" Style="{StaticResource TextKpi}" Text="..."/>
                                    <TextBlock x:Name="DashSecNote" Style="{StaticResource TextMuted}" Margin="0,4,0,0" Text="Reading the security score"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="DashTileHealth" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Border x:Name="DashHealthDisc" Style="{StaticResource IconDisc}" Margin="0,0,10,0"><TextBlock x:Name="DashHealthIcon" Style="{StaticResource Icon}" Text="&#xE95E;" HorizontalAlignment="Center"/></Border>
                                        <TextBlock Style="{StaticResource TextOverline}" Text="SYSTEM HEALTH" Margin="0" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="DashHealthValue" Style="{StaticResource TextKpi}" Text="..."/>
                                    <TextBlock x:Name="DashHealthNote" Style="{StaticResource TextMuted}" Margin="0,4,0,0" Text="Running health checks"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="DashTileChanges" Style="{StaticResource Tile}" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Border x:Name="DashChangesDisc" Style="{StaticResource IconDisc}" Margin="0,0,10,0"><TextBlock x:Name="DashChangesIcon" Style="{StaticResource Icon}" Text="&#xE81C;" HorizontalAlignment="Center"/></Border>
                                        <TextBlock Style="{StaticResource TextOverline}" Text="YOUR CHANGES" Margin="0" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="DashChangesValue" Style="{StaticResource TextKpi}" Text="..."/>
                                    <TextBlock x:Name="DashChangesNote" Style="{StaticResource TextMuted}" Margin="0,4,0,0" Text="Every change is reversible"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Style="{StaticResource TextOverline}" Text="DO THIS NEXT" Margin="0,8,0,8"/>
                        <Border Style="{StaticResource Card}" Padding="6,6">
                            <StackPanel>
                                <StackPanel x:Name="DashAllClear" Orientation="Horizontal" Margin="12,10" Visibility="Collapsed">
                                    <Border Style="{StaticResource IconDisc}" Background="{DynamicResource BrushSuccessSoft}" Margin="0,0,12,0"><TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{DynamicResource BrushSuccess}" HorizontalAlignment="Center"/></Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Nothing needs your attention" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource TextMuted}" Text="Every check passed. Open Presets to tune further."/>
                                    </StackPanel>
                                </StackPanel>
                                <ItemsControl x:Name="DashActionList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12,10" Margin="0,0,0,2" CornerRadius="8" Background="{Binding RowBrush}" ToolTip="{Binding Tip}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="{Binding DiscBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{Binding Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Action}" Foreground="{DynamicResource BrushAccent}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Style="{StaticResource Badge}" BorderBrush="{Binding Brush}" Margin="10,0,0,0" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Level}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{Binding Brush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="DashMoreText" Style="{StaticResource TextMuted}" Margin="12,6,12,6" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource TextOverline}" Text="DETAILS" Margin="0,8,0,8"/>
                        <Expander Style="{StaticResource SectionExpander}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" Margin="0,0,10,0"/><TextBlock Text="Anti-cheat readiness" FontWeight="SemiBold"/><TextBlock x:Name="DashAcSummary" Style="{StaticResource TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                            </Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ItemsControl x:Name="AcReqList" Grid.Column="0" Margin="0,0,12,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,4" ToolTip="{Binding Detail}">
                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding Brush}" FontSize="14" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl x:Name="AcMatrixList" Grid.Column="1">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4" ToolTip="{Binding Note}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding Brush}" FontSize="14" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource TextMuted}" Text="{Binding Missing}" Margin="24,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Expander>

                        <Expander Style="{StaticResource SectionExpander}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Margin="0,0,10,0"/><TextBlock Text="Security score" FontWeight="SemiBold"/><TextBlock x:Name="DashSecSummary" Style="{StaticResource TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock x:Name="SecurityScoreText" FontSize="{DynamicResource FontSizeTitleSmall}" FontWeight="SemiBold" Text="Not read yet (press Refresh)."/>
                                <TextBlock Style="{StaticResource TextMuted}" Text="Weighted checklist of protections that matter on a gaming PC. Each open item names its fix: a catalog item, the ASR Center, Windows Security or the firmware setup." Margin="0,2,0,8"/>
                                <ItemsControl x:Name="SecurityFixList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3" ToolTip="{Binding Hint}">
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding Brush}" FontWeight="SemiBold" Width="56"/>
                                                <TextBlock TextWrapping="Wrap"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding Value, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding Route, Mode=OneWay}" Foreground="{DynamicResource BrushAccent}"/></TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource SectionExpander}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE95E;" Margin="0,0,10,0"/><TextBlock Text="System health" FontWeight="SemiBold"/><TextBlock x:Name="DashHealthSummary" Style="{StaticResource TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                            </Expander.Header>
                            <ItemsControl x:Name="HealthList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource Badge}" BorderBrush="{Binding Brush}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding Brush}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding Value, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding Section, Mode=OneWay}" Foreground="{DynamicResource BrushTextMuted}"/></TextBlock>
                                                    <TextBlock Style="{StaticResource TextMuted}" Text="{Binding Detail}"/>
                                                    <TextBlock Text="{Binding Advice}" Foreground="{DynamicResource BrushAccent}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}" Visibility="{Binding AdviceVisibility}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <Expander Style="{StaticResource SectionExpander}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE950;" Margin="0,0,10,0"/><TextBlock Text="Hardware profile" FontWeight="SemiBold"/><TextBlock x:Name="DashHwSummary" Style="{StaticResource TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <ItemsControl x:Name="HardwareTagList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Badge}" BorderBrush="{DynamicResource BrushAccent}" Margin="0,0,6,6" ToolTip="{Binding Hint}">
                                                <TextBlock FontSize="{DynamicResource FontSizeCaption}"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Id, Mode=OneWay}" Foreground="{DynamicResource BrushTextMuted}"/></TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource TextMuted}" Text="Hardware overlays adjust presets on this PC (presets are resolved as preset, then overlays, then your own changes):" Margin="0,6,0,4"/>
                                <ItemsControl x:Name="HardwareOverlayList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4">
                                                <TextBlock TextWrapping="Wrap"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ("/><Run Text="{Binding Tags, Mode=OneWay}" Foreground="{DynamicResource BrushTextMuted}"/><Run Text=")"/></TextBlock>
                                                <TextBlock Style="{StaticResource TextMuted}" Text="{Binding Hint}"/>
                                                <TextBlock Text="{Binding Guidance}" Foreground="{DynamicResource BrushAccent}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource SectionExpander}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" Margin="0,0,10,0"/><TextBlock Text="NVIDIA checklist" FontWeight="SemiBold"/><TextBlock Style="{StaticResource TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center" Text="read-only; driver profiles are never written"/></StackPanel>
                            </Expander.Header>
                            <ItemsControl x:Name="NvidiaList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap" Margin="0,3"><Run Text="{Binding Item, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding Advice, Mode=OneWay}" Foreground="{DynamicResource BrushTextMuted}"/></TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <Expander Style="{StaticResource SectionExpander}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" Margin="0,0,10,0"/><TextBlock Text="Outside Windows" FontWeight="SemiBold"/><TextBlock Style="{StaticResource TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center" Text="BIOS, router and game settings"/></StackPanel>
                            </Expander.Header>
                            <ItemsControl x:Name="RecommendList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap" Margin="0,3"><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding Text, Mode=OneWay}" Foreground="{DynamicResource BrushTextMuted}"/></TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- Presets -->
                <ScrollViewer x:Name="PagePresets" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextTitle}" Text="Presets"/>
                        <TextBlock Style="{StaticResource TextMuted}" Text="Choosing a preset stages only the changes that differ from your current state. Review them on the category pages (pending items are marked), untick anything you do not want, then Preview and Apply."/>
                        <Border x:Name="PresetDriftCard" Style="{StaticResource Card}" Margin="0,12,10,0" Visibility="Collapsed">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button x:Name="PresetDriftReapplyButton" Content="Re-apply" ToolTip="Stage the changed items again, then Preview and Apply."/>
                                    <Button x:Name="PresetDriftAdoptButton" Content="Adopt as custom..." Margin="0" ToolTip="Save the preset without the items you changed as your own custom preset."/>
                                </WrapPanel>
                                <TextBlock x:Name="PresetDriftText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,12,10,0">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <CheckBox x:Name="SessionCloseAppsBox" Style="{StaticResource FilterCheck}" Content="Close listed apps" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Also close running apps from the Session Mode list (OneDrive, Teams, Spotify, Dropbox and similar) after you confirm them."/>
                                    <Button x:Name="SessionStartButton" Style="{StaticResource AccentButton}" Content="Start session" ToolTip="Apply the temporary session settings with a snapshot. They are restored when you end the session or close iG Windows Tuner."/>
                                    <Button x:Name="SessionStopButton" Content="End session" Margin="0" ToolTip="Restore every setting from the session snapshot."/>
                                </WrapPanel>
                                <StackPanel>
                                    <TextBlock Text="Session Mode (Tournament / LAN)" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SessionStatusText" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,12,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ItemsControl x:Name="PresetCards" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="16">
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Bottom" Style="{StaticResource AccentButton}" Content="{Binding ButtonText}" Tag="{Binding Id}" HorizontalAlignment="Left" Margin="0,12,0,0" ToolTip="Stage this preset's differences from your current state."/>
                                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource TextMuted}" Text="{Binding Summary}" Margin="0,8,0,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeTitleSmall}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Tagline}" Foreground="{DynamicResource BrushAccent}" Margin="0,2,0,8"/>
                                                <TextBlock Style="{StaticResource TextMuted}" Text="{Binding Description}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource TextSection}" Text="Custom presets"/>
                        <TextBlock Style="{StaticResource TextMuted}" TextWrapping="Wrap" Text="Start from any preset, add or remove items and save it as your own. Custom presets follow the same rules as the built-in ones (level ceiling, never Lab or Risk Zone items, gaming presets anti-cheat safe only) and are stored with a SHA256 integrity field."/>
                        <WrapPanel Margin="0,8,0,0">
                            <ComboBox x:Name="PresetPickBox" Width="260" Margin="0,0,10,0" DisplayMemberPath="name" ToolTip="The preset the buttons on the right work with."/>
                            <Button x:Name="PresetCustomizeButton" Content="Customize..." ToolTip="Pick the items of a new custom preset, starting from the selected preset."/>
                            <Button x:Name="PresetDuplicateButton" Content="Duplicate..." ToolTip="Save a copy of the selected preset as a custom preset."/>
                            <Button x:Name="PresetExportButton" Content="Export..." ToolTip="Save the selected preset as a JSON file with a SHA256 integrity field."/>
                            <Button x:Name="PresetImportButton" Content="Import..." ToolTip="Import a preset file; its SHA256 field and the preset rules are checked first."/>
                            <Button x:Name="PresetDeleteButton" Content="Delete" Margin="0" ToolTip="Delete the selected custom preset (built-in presets cannot be deleted)."/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource TextSection}" Text="Undo"/>
                        <WrapPanel>
                            <Button x:Name="RevertLastButton" Content="Revert last apply" ToolTip="Restore every value captured before the most recent apply or preset."/>
                            <Button x:Name="RevertSnapshotButton" Content="Revert from snapshot..." ToolTip="Pick a snapshot file from %ProgramData%\iGWindowsTuner\Backups and restore it."/>
                            <Button x:Name="ResetStagedButton" Content="Reset selected to Windows default" ToolTip="Stage 'reset to the documented Windows default' for the tweak selected on a category page."/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Tweak category pages (shared) -->
                <Grid x:Name="PageTweaks" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <StackPanel x:Name="SecuritySwitch" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed">
                            <Button x:Name="SecHardeningButton" Style="{StaticResource AccentButton}" Content="Hardening items" ToolTip="Security items of the catalog (VBS/HVCI, Defender, firewall, hardening)."/>
                            <Button x:Name="SecAsrButton" Content="ASR Center" ToolTip="Attack surface reduction rules (part of Security)."/>
                            <Button x:Name="SecDefenderButton" Content="Defender settings" ToolTip="Every Microsoft Defender Antivirus setting and Defender Group Policy (part of Security)."/>
                            <Button x:Name="SecFirewallButton" Content="Firewall" Margin="0" ToolTip="Every firewall rule and profile (part of Security)."/>
                        </StackPanel>
                        <TextBlock x:Name="TweakPageTitle" Style="{StaticResource TextTitle}" Text="Tweaks"/>
                        <TextBlock x:Name="TweakPageSubtitle" Style="{StaticResource TextMuted}" Text="Toggles show the real current state. Toggling stages a change; nothing happens until you press Apply."/>
                    </StackPanel>
                    <ContentControl x:Name="TweakGridHost" Grid.Row="1" Grid.RowSpan="2" Margin="0,10,0,0" Focusable="False"/>
                </Grid>
                <!-- Expert inspectors -->
                <Grid x:Name="PageInspect" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <DockPanel>
                            <Button x:Name="InspectRefreshButton" DockPanel.Dock="Right" Content="Refresh" Margin="0" VerticalAlignment="Top" ToolTip="Read everything again from the live system (read-only)."/>
                            <TextBlock Style="{StaticResource TextTitle}" Text="Expert inspectors"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource TextMuted}" Text="Read-only views of the settings engineers tune, with the Windows default next to each value. Only the processor power settings can be edited here (Expert, snapshot first); everything else changes only through catalog items. Popular 'hidden kernel tweaks' are explained, not applied."/>
                    </StackPanel>
                    <TabControl x:Name="InspectTabs" Grid.Row="1" Margin="0,10,0,0" Background="Transparent" BorderThickness="0">
                        <TabItem Header="Power plan" ToolTip="Processor power settings of the active plan, hidden ones included">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <CheckBox x:Name="InspectPowerAllBox" DockPanel.Dock="Right" Style="{StaticResource FilterCheck}" Content="Show all settings" ToolTip="Show every processor setting, not only the editable ones and those that differ from the default."/>
                                    <TextBlock x:Name="InspectPowerSummary" Style="{StaticResource TextMuted}" VerticalAlignment="Center" Text="Not read yet."/>
                                </DockPanel>
                                <ContentControl x:Name="InspectPowerListHost" Grid.Row="1" Focusable="False"/>
                                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="InspectPowerDetailName" FontWeight="SemiBold" Text="Select a setting"/>
                                        <TextBlock x:Name="InspectPowerDetailText" Style="{StaticResource TextMuted}" Margin="0,2,0,6"/>
                                        <WrapPanel>
                                            <TextBlock Text="Plugged in (AC)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox x:Name="InspectPowerAcBox" Width="80" Margin="0,0,14,0" ToolTip="New plugged-in value (index or percentage, as listed)."/>
                                            <TextBlock Text="Battery (DC)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox x:Name="InspectPowerDcBox" Width="80" Margin="0,0,14,0" ToolTip="New battery value. Leave empty to keep it."/>
                                            <Button x:Name="InspectPowerApplyButton" Content="Apply to active plan" ToolTip="Validate, confirm, write a snapshot and change this setting in the active plan. Expert; needs administrator rights."/>
                                            <Button x:Name="InspectPowerDefaultButton" Content="Windows default" Margin="0" ToolTip="Set this setting back to the Windows default of the plan, after a confirmation (snapshot first)."/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Interrupts" ToolTip="Interrupt mode, MSI configuration and affinity of PCI devices">
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="InspectIrqSummary" DockPanel.Dock="Top" Style="{StaticResource TextMuted}" Margin="0,0,0,6" Text="Not read yet."/>
                                <ContentControl x:Name="InspectIrqListHost" Focusable="False"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Network queues" ToolTip="Receive side scaling, queues and buffers of the network adapters">
                            <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="InspectNicList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Rss}" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding Buffers}" Style="{StaticResource TextMuted}"/>
                                                    <TextBlock Text="{Binding Advice}" Foreground="{DynamicResource BrushAccent}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Kernel &amp; memory" ToolTip="Kernel, memory, priority, multimedia and crash registry values with Windows defaults">
                            <DockPanel Margin="0,8,0,0">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <CheckBox x:Name="InspectKernelChangedBox" DockPanel.Dock="Right" Style="{StaticResource FilterCheck}" Content="Only values that differ" IsChecked="True" ToolTip="Hide values that are at the Windows default."/>
                                    <TextBlock x:Name="InspectKernelSummary" Style="{StaticResource TextMuted}" VerticalAlignment="Center" Text="Not read yet."/>
                                </DockPanel>
                                <ContentControl x:Name="InspectKernelListHost" Focusable="False"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Timer &amp; crash" ToolTip="Timer resolution behaviour, crash dumps and page file">
                            <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="InspectCrashText" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FontSizeCaption}" ToolTip="Read-only summary of the timer, crash dump and page file configuration."/>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- Manage -->
                <Grid x:Name="PageManage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <DockPanel>
                            <Button x:Name="ManageRefreshButton" DockPanel.Dock="Right" Content="Refresh" Margin="0" VerticalAlignment="Top" ToolTip="Read services, tasks, apps, persistence entries and firewall rules again (read-only)."/>
                            <TextBlock Style="{StaticResource TextTitle}" Text="Manage"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource TextMuted}" Text="Every change here writes a snapshot first and can be reverted in Backups &amp; Logs. Protected services, tasks and apps (core Windows, security, update, audio, network, GPU drivers, anti-cheat) are refused. Nothing is ever deleted except inbox apps you remove on purpose."/>
                    </StackPanel>
                    <TabControl x:Name="ManageTabs" Grid.Row="1" Margin="0,10,0,0" Background="Transparent" BorderThickness="0">
                        <TabItem Header="Services" ToolTip="Every service with its startup type and a safe-to-change rating">
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="ManageServiceSummary" DockPanel.Dock="Top" Style="{StaticResource TextMuted}" Margin="0,0,0,6" Text="Not read yet."/>
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="ManageServiceDetail" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6" Text="Select a service."/>
                                        <WrapPanel>
                                            <TextBlock Text="Startup type" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox x:Name="ManageServiceStartBox" Width="170" Margin="0,0,10,0" ToolTip="Manual starts the service when something needs it; it is safer than Disabled."/>
                                            <Button x:Name="ManageServiceApplyButton" Content="Change startup type" Margin="0" ToolTip="Confirm, write a snapshot and change the startup type. Needs administrator rights."/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <ContentControl x:Name="ManageServiceGridHost" Focusable="False"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Scheduled tasks" ToolTip="All scheduled tasks; disable only, never delete">
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="ManageTaskSummary" DockPanel.Dock="Top" Style="{StaticResource TextMuted}" Margin="0,0,0,6" TextWrapping="Wrap" Text="Not read yet."/>
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="ManageTaskDetail" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6" Text="Select a task."/>
                                        <WrapPanel>
                                            <Button x:Name="ManageTaskDisableButton" Content="Disable task" ToolTip="Confirm, write a snapshot and disable this task. Security, update and anti-cheat tasks are refused."/>
                                            <Button x:Name="ManageTaskEnableButton" Content="Enable task" Margin="0" ToolTip="Confirm, write a snapshot and enable this task again."/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <ContentControl x:Name="ManageTaskGridHost" Focusable="False"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Apps" ToolTip="Installed Win32 apps and inbox (Appx) apps">
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="ManageAppSummary" DockPanel.Dock="Top" Style="{StaticResource TextMuted}" Margin="0,0,0,6" TextWrapping="Wrap" Text="Not read yet."/>
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="ManageAppDetail" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6" Text="Select an app."/>
                                        <WrapPanel>
                                            <CheckBox x:Name="ManageAppProvisionedBox" Style="{StaticResource FilterCheck}" Content="Also for new user profiles" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Also remove the provisioned copy so new user profiles do not get the app."/>
                                            <Button x:Name="ManageAppRemoveButton" Content="Remove inbox app" Margin="0" ToolTip="Confirm, write a snapshot and remove this inbox app. Revert re-registers it or reinstalls it from the Microsoft Store."/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <ContentControl x:Name="ManageAppGridHost" Focusable="False"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Persistence" ToolTip="Read-only Autoruns-style view of everything that starts automatically, with signatures">
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="ManagePersistSummary" DockPanel.Dock="Top" Style="{StaticResource TextMuted}" Margin="0,0,0,6" TextWrapping="Wrap" Text="Not read yet."/>
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="ManagePersistDetail" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6" Text="Select an entry."/>
                                        <WrapPanel>
                                            <Button x:Name="ManagePersistDisableButton" Content="Disable" ToolTip="Disable this entry with its documented mechanism (startup entry, service startup type or task), snapshot first."/>
                                            <Button x:Name="ManagePersistExportButton" Content="Export report" Margin="0" ToolTip="Save the persistence report as an HTML file (no scripts) in the Reports folder."/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <ContentControl x:Name="ManagePersistGridHost" Focusable="False"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Hosts file" ToolTip="Read-only hosts-file viewer; firewall rules are in Security > Firewall">
                            <StackPanel Margin="0,8,0,0">
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <Button x:Name="ManageOpenFirewallButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Open the Firewall Manager" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Security > Firewall: every rule with risk views, rule actions and the profiles."/>
                                        <TextBlock Style="{StaticResource TextMuted}" TextWrapping="Wrap" VerticalAlignment="Center" Text="Firewall rules moved to Security > Firewall, a full rule manager with search, filters, risk views and safe actions."/>
                                    </DockPanel>
                                </Border>
                                <TextBlock x:Name="ManageHostsText" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,0" Text="Not read yet."/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- Firewall Manager (Security > Firewall) -->
                <Grid x:Name="PageFirewall" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="FwNewRuleButton" Style="{StaticResource AccentButton}" Content="New rule..." ToolTip="Create a firewall rule step by step (program, ports, networks), with a summary before anything changes."/>
                                <Button x:Name="FwRefreshButton" Content="Refresh" Margin="0" ToolTip="Read every rule and profile again (read-only)."/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource TextTitle}"><Run Text="Security" Foreground="{DynamicResource BrushTextMuted}"/><Run Text="  &#x203A;  " Foreground="{DynamicResource BrushTextMuted}"/><Run Text="Firewall"/></TextBlock>
                        </DockPanel>
                        <TextBlock Style="{StaticResource TextMuted}" TextWrapping="Wrap" Text="Every rule of the active firewall policy, with where it comes from and what looks risky. Every change shows a summary first, writes a snapshot and can be undone. Group Policy rules are locked, Windows rules can only be enabled or disabled, and the firewall itself is never turned off."/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock x:Name="FwSummaryIcon" Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,8,0"/>
                            <TextBlock x:Name="FwSummaryText" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Text="Not read yet."/>
                        </StackPanel>
                        <TextBlock x:Name="FwNoticeText" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <TabControl x:Name="FwTabs" Grid.Row="1" Margin="0,10,0,0">
                        <TabItem x:Name="FwOverviewTab" Header="Overview" ToolTip="What needs attention, the nine rule groups, quick wins, open ports and recent changes">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                <StackPanel>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                        <DockPanel>
                                            <TextBlock x:Name="FwOvUpdatedText" DockPanel.Dock="Right" Style="{StaticResource TextCaption}" VerticalAlignment="Top" Text=""/>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource TextSection}" Margin="0,0,0,4" Text="Status"/>
                                                <TextBlock x:Name="FwOvStatusText" TextWrapping="Wrap" Text="Not read yet."/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="FwOvAttentionCard" Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="FwOvAttentionIcon" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock x:Name="FwOvAttentionTitle" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" VerticalAlignment="Center" Text="Needs attention"/>
                                                </StackPanel>
                                                <TextBlock x:Name="FwOvAttentionText" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,10" Text="Not read yet."/>
                                                <Button x:Name="FwOvReviewButton" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0" Content="Review risks" ToolTip="Walk through the findings one at a time: fix, skip or ignore each, with a summary at the end."/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="FwOvQuickCard" Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" VerticalAlignment="Center" Text="Quick wins"/>
                                                </StackPanel>
                                                <TextBlock x:Name="FwOvQuickText" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,10" Text="Not read yet."/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="FwOvQuickButton" Margin="0,0,8,0" Content="Preview" ToolTip="Show which rules would be disabled and what stops working, before anything changes."/>
                                                    <Button x:Name="FwOvScopeButton" Margin="0" Content="Firewall scope..." ToolTip="Preview a preset for this kind of PC (Gaming PC, Workstation, Public Wi-Fi laptop, Sysadmin hardened): which bloated rules and risk fixes would apply."/>
                                                    <Button x:Name="FwOvExportOverridesButton" Margin="8,0,0,0" Content="Export my choices..." ToolTip="Save your category changes, 'not bloated' marks and ignored findings to a file (for another PC or a backup)."/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Style="{StaticResource TextSection}" Text="Rule groups"/>
                                    <WrapPanel x:Name="FwOvTiles" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource TextSection}" Margin="0,0,0,6" Text="Rules by origin"/>
                                                <StackPanel x:Name="FwOvOriginChart" AutomationProperties.Name="Rules by origin chart"/>
                                                <TextBlock x:Name="FwOvOriginText" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource TextSection}" Margin="0,0,0,6" Text="Enabled rules by direction and action"/>
                                                <StackPanel x:Name="FwOvDirChart" AutomationProperties.Name="Direction and action chart"/>
                                                <TextBlock x:Name="FwOvDirText" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Style="{StaticResource TextSection}" Text="Open ports (exposure map)"/>
                                    <TextBlock x:Name="FwOvExposureText" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6" Text="Programs listening for connections right now, the rules that let traffic reach them, and whether they are reachable from the network."/>
                                    <ContentControl x:Name="FwOvExposureHost" Height="280" Margin="0,0,0,10" Focusable="False"/>
                                    <TextBlock Style="{StaticResource TextSection}" Text="Recent changes"/>
                                    <TextBlock x:Name="FwOvRecentEmpty" Style="{StaticResource TextMuted}" Text="No firewall changes yet. Every change writes a snapshot and shows up here with Undo."/>
                                    <ItemsControl x:Name="FwOvRecentList" Margin="0,0,0,10"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="FwRulesTab" Header="Rules" ToolTip="Every firewall rule by group: search, filter, sort and manage">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="350"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="6">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Bottom" Margin="4,8,4,0">
                                            <TextBlock Style="{StaticResource TextCaption}" Text="Saved views" Margin="0,0,0,4"/>
                                            <ListBox x:Name="FwViewList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="160" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Saved views" ToolTip="Views saved from the View menu of the list (filters, sort and columns)."/>
                                            <TextBlock x:Name="FwViewEmpty" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Text="Save a view from the View menu to find it here."/>
                                        </StackPanel>
                                        <ListBox x:Name="FwGroupList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Rule groups" KeyboardNavigation.TabNavigation="Once">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel ToolTip="{Binding Tip}" Margin="2,3">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource FontIcons}" Foreground="{Binding Brush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                                <DockPanel Grid.Column="1" Margin="0,0,12,0">
                                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                        <Button x:Name="FwBulkButton" Content="Act on this group..." ToolTip="Disable, enable or restrict every rule of the selected group, with a preview first. Locked rules are skipped with the reason."/>
                                        <Button x:Name="FwImportButton" Content="Import..." ToolTip="Import rules from an iG Windows Tuner JSON export; a preview lists new and changed rules before anything changes."/>
                                        <Button x:Name="FwExportButton" Content="Export all..." ToolTip="Save every rule to JSON (importable) or CSV. The firewall is not changed."/>
                                        <Button x:Name="FwReportButton" Content="Audit report..." ToolTip="Save a firewall audit report (HTML, CSV or JSON): categories, findings, open ports and recommendations."/>
                                        <Button x:Name="FwExportPolicyButton" Content="Export full policy (.wfw)..." Margin="0" ToolTip="Back up the whole firewall policy with netsh advfirewall export. The firewall is not changed."/>
                                    </WrapPanel>
                                    <ContentControl x:Name="FwGridHost" Focusable="False"/>
                                </DockPanel>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock x:Name="FwDetName" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" TextWrapping="Wrap" Text="Select a rule"/>
                                            <TextBlock x:Name="FwDetMeta" Style="{StaticResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="FwDetSummary" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            <WrapPanel x:Name="FwDetChips" Margin="0,8,0,0"/>
                                            <Border x:Name="FwDetRiskBox" Background="{DynamicResource BrushWarningSoft}" BorderBrush="{DynamicResource BrushWarning}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0" Visibility="Collapsed">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE72E;" Foreground="{DynamicResource BrushWarning}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                                    <TextBlock x:Name="FwDetRisk" TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </Border>
                                            <TextBlock x:Name="FwDetFindingsTitle" Style="{StaticResource TextSection}" Text="Findings"/>
                                            <ItemsControl x:Name="FwDetFindings"/>
                                            <TextBlock Style="{StaticResource TextSection}" Text="Why this rule exists"/>
                                            <TextBlock x:Name="FwDetWhyExists" Style="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                                            <TextBlock Style="{StaticResource TextSection}" Text="Classification"/>
                                            <TextBlock x:Name="FwDetOrigin" TextWrapping="Wrap"/>
                                            <WrapPanel Margin="0,6,0,0">
                                                <Button x:Name="FwDetMoveButton" Content="Move to category..." Margin="0,0,6,6" ToolTip="Put this rule in another category if the classification is wrong; remembered for this PC and exportable."/>
                                                <Button x:Name="FwDetNotBloatedButton" Content="Not bloated for me" Margin="0,0,6,6" ToolTip="Keep this rule out of Bloated (you use the feature); remembered for this PC."/>
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource TextSection}" Text="Conflicts"/>
                                            <TextBlock x:Name="FwDetPrecedence" Style="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                                            <TextBlock Style="{StaticResource TextSection}" Text="Actions"/>
                                            <WrapPanel>
                                                <Button x:Name="FwEnableButton" Content="Enable" Margin="0,0,6,6" ToolTip="Turn this rule on (snapshot first)."/>
                                                <Button x:Name="FwDisableButton" Content="Disable" Margin="0,0,6,6" ToolTip="Turn this rule off (snapshot first). Windows rules can be disabled, not deleted."/>
                                                <Button x:Name="FwAllowButton" Content="Set to Allow" Margin="0,0,6,6" ToolTip="Change the action to Allow (snapshot first)."/>
                                                <Button x:Name="FwBlockButton" Content="Set to Block" Margin="0,0,6,6" ToolTip="Change the action to Block (snapshot first). The program may stop working online."/>
                                                <Button x:Name="FwEditButton" Content="Edit..." Margin="0,0,6,6" ToolTip="Change the name, networks, ports, addresses or program (snapshot first)."/>
                                                <Button x:Name="FwDuplicateButton" Content="Duplicate" Margin="0,0,6,6" ToolTip="Copy this rule as a new iG Windows Tuner rule you can change."/>
                                                <Button x:Name="FwDeleteButton" Style="{StaticResource DangerButton}" Content="Delete..." Margin="0,0,6,6" ToolTip="Delete this rule (a snapshot keeps it so Undo recreates it). Windows rules are never deleted."/>
                                            </WrapPanel>
                                            <TextBlock x:Name="FwDetWhy" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            <TextBlock Style="{StaticResource TextSection}" Text="Details"/>
                                            <TextBlock x:Name="FwDetText" Style="{StaticResource TextMuted}" TextWrapping="Wrap" FontFamily="{DynamicResource FontUi}"/>
                                            <TextBlock Style="{StaticResource TextSection}" Text="Change history"/>
                                            <TextBlock x:Name="FwDetHistory" Style="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="FwConnectionsTab" Header="Live connections" ToolTip="Current connections and open UDP endpoints with the program and the rule that applies (read-only)">
                            <DockPanel Margin="0,8,0,0">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Button x:Name="FwConnRefreshButton" DockPanel.Dock="Right" Content="Read connections" Margin="0" ToolTip="Read the current TCP connections and UDP endpoints (read-only)."/>
                                    <TextBlock x:Name="FwConnText" Style="{StaticResource TextMuted}" TextWrapping="Wrap" VerticalAlignment="Center" Text="Shows what is connected right now and which rule applies. Nothing is changed."/>
                                </DockPanel>
                                <ContentControl x:Name="FwConnHost" Focusable="False"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="FwDefaultsTab" Header="Compared to Windows defaults" ToolTip="Rules added, removed or changed compared with the default rules of this Windows build">
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="FwDefaultsText" DockPanel.Dock="Top" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6" Text="Not read yet."/>
                                <ContentControl x:Name="FwDefaultsHost" Focusable="False"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Profiles and networks" ToolTip="Domain, Private and Public profiles, and the network category of each connection">
                            <ScrollViewer x:Name="FwProfilesPanel" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TextMuted}" TextWrapping="Wrap" Text="Each network uses one profile: Public for networks you do not control (cafes, hotels, school), Private for your home network. Changes here only move toward more protection: the firewall stays on and inbound traffic stays blocked by default."/>
                                    <ItemsControl x:Name="FwProfileList" Margin="0,10,0,0">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Card}" Width="320" Margin="0,0,12,12">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding StateGlyph}" Foreground="{Binding StateBrush}" FontSize="14" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        <TextBlock Style="{StaticResource TextMuted}" Text="{Binding Detail}"/>
                                                        <DockPanel Margin="0,8,0,0">
                                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Notifications, Mode=OneWay}" Tag="{Binding NotifyTag}" ToolTip="Notify me when a program is blocked from listening" AutomationProperties.Name="{Binding NotifyName}"/>
                                                            <TextBlock Text="Notify when a program is blocked" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                        <DockPanel Margin="0,6,0,0">
                                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LogBlocked, Mode=OneWay}" Tag="{Binding LogBlockedTag}" ToolTip="Log dropped packets (for the firewall log analyzer)" AutomationProperties.Name="{Binding LogBlockedName}"/>
                                                            <TextBlock Text="Log blocked connections" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                        <DockPanel Margin="0,6,0,0">
                                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LogAllowed, Mode=OneWay}" Tag="{Binding LogAllowedTag}" ToolTip="Log allowed connections (large logs)" AutomationProperties.Name="{Binding LogAllowedName}"/>
                                                            <TextBlock Text="Log allowed connections" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                        <DockPanel Margin="0,6,0,0">
                                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding UnicastResponse, Mode=OneWay}" Tag="{Binding UnicastTag}" ToolTip="Allow unicast responses to multicast and broadcast traffic (needed by some discovery protocols)" AutomationProperties.Name="{Binding UnicastName}"/>
                                                            <TextBlock Text="Unicast response to multicast" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                        <WrapPanel Margin="0,10,0,0">
                                                            <Button Content="Turn on" Style="{StaticResource AccentButton}" Tag="{Binding TurnOnTag}" Visibility="{Binding TurnOnVisibility}" Margin="0,0,6,0" ToolTip="Turn this firewall profile on (snapshot first)."/>
                                                            <Button Content="{Binding OutboundText}" Tag="{Binding OutboundTag}" Margin="0" ToolTip="Switch the default for outbound connections between Allow and Block (snapshot first). Block needs outbound rules for every program."/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource TextSection}" Text="Connected networks"/>
                                    <ItemsControl x:Name="FwNetworkList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Card}">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Set to Private" Tag="{Binding PrivateTag}" IsEnabled="{Binding CanPrivate}" ToolTip="Home network you trust: allows discovery and sharing rules for this network (snapshot first)."/>
                                                            <Button Content="Set to Public" Tag="{Binding PublicTag}" IsEnabled="{Binding CanPublic}" Margin="0" ToolTip="Networks you do not control: the safer choice (snapshot first)."/>
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                            <TextBlock Style="{StaticResource TextMuted}" Text="{Binding Detail}"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="FwProfileNote" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <Button x:Name="FwLogButton" Content="Analyze the firewall log" HorizontalAlignment="Left" Margin="0,10,0,0" ToolTip="Summarize blocked and allowed connections from the firewall log (read-only). Turn on logging above first."/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- Group Policy browser -->
                <Grid x:Name="PagePolicy" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <DockPanel>
                            <Button x:Name="PolRefreshButton" DockPanel.Dock="Right" Content="Refresh" Margin="0" VerticalAlignment="Top" ToolTip="Read the policy definitions and the Local Group Policy again (read-only)."/>
                            <TextBlock Style="{StaticResource TextTitle}" Text="Group Policy"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource TextMuted}" TextWrapping="Wrap" Text="Every policy of the installed administrative templates with its Local Group Policy state. Pick a category on the left or search. Settings that would turn a security protection off are refused, and a backup of the Local Group Policy is taken before every change."/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock x:Name="PolSummaryIcon" Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,8,0"/>
                            <TextBlock x:Name="PolSummaryText" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Text="Not read yet."/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="330"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="6">
                            <TreeView x:Name="PolTree" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Policy categories"/>
                        </Border>
                        <ContentControl x:Name="PolGridHost" Grid.Column="1" Margin="0,0,12,0" Focusable="False"/>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="PolDetName" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" TextWrapping="Wrap" Text="Select a policy"/>
                                    <TextBlock x:Name="PolDetMeta" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="PolDetState" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <StackPanel x:Name="PolEditPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                        <TextBlock Style="{StaticResource TextCaption}" Text="Set to" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="PolStateBox" DisplayMemberPath="Label" AutomationProperties.Name="Set the policy to" ToolTip="The states this policy can be set to here; options that turn a protection off are not allowed."/>
                                        <TextBlock x:Name="PolHelp" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,6,0,6"/>
                                        <Button x:Name="PolApplyButton" Style="{StaticResource AccentButton}" Content="Apply" HorizontalAlignment="Left" ToolTip="Set the policy after a confirmation (Local Group Policy backup first). Needs administrator rights."/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource TextSection}" Text="Explanation"/>
                                    <TextBlock x:Name="PolDetExplain" Style="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Toolkit -->
                <Grid x:Name="PageToolkit" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <DockPanel>
                            <Button x:Name="ToolkitRefreshButton" DockPanel.Dock="Right" Content="Refresh" Margin="0" VerticalAlignment="Top" ToolTip="Read the Toolkit lists and states again (read-only)."/>
                            <TextBlock Style="{StaticResource TextTitle}" Text="Toolkit"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource TextMuted}" TextWrapping="Wrap" Text="Inspired by Chris Titus Tech's WinUtil (MIT), re-implemented with documented sources: install apps with winget, turn Windows features on or off, run repair fixes after a preview, and open classic panels. Nothing is downloaded except the packages you pick. Feature changes write a snapshot first."/>
                    </StackPanel>
                    <TabControl x:Name="ToolkitTabs" Grid.Row="1" Margin="0,10,0,0" Background="Transparent" BorderThickness="0">
                        <TabItem Header="Install" ToolTip="Curated winget packages: install, upgrade, uninstall, import and export a selection">
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="ToolkitAppSummary" DockPanel.Dock="Top" Style="{StaticResource TextMuted}" Margin="0,0,0,6" TextWrapping="Wrap" Text="Not read yet."/>
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="ToolkitAppDetail" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6" Text="Select one or more apps (Ctrl or Shift to select several)."/>
                                        <WrapPanel>
                                            <Button x:Name="ToolkitAppStateButton" Content="Check installed" ToolTip="Read which packages are installed with one winget export (read-only)."/>
                                            <Button x:Name="ToolkitInstallButton" Style="{StaticResource AccentButton}" Content="Install selected" ToolTip="Install the selected packages with winget. The first time, winget's agreements are shown for you to accept."/>
                                            <Button x:Name="ToolkitUpgradeButton" Content="Upgrade selected" ToolTip="Upgrade the selected packages with winget."/>
                                            <Button x:Name="ToolkitUninstallButton" Content="Uninstall selected" ToolTip="Uninstall the selected packages with winget."/>
                                            <Button x:Name="ToolkitUpgradeAllButton" Content="Upgrade all" ToolTip="winget upgrade --all for packages from the winget source."/>
                                            <Button x:Name="ToolkitImportButton" Content="Import list" ToolTip="Select the apps from a saved selection file (SHA256-checked)."/>
                                            <Button x:Name="ToolkitExportButton" Content="Export selection" Margin="0" ToolTip="Save the selected apps to a selection file with a SHA256 integrity field."/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <ContentControl x:Name="ToolkitAppListHost" Focusable="False"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Tweaks" ToolTip="WinUtil-derived catalog items; they also appear in their normal categories">
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="ToolkitTweakSummary" DockPanel.Dock="Top" Style="{StaticResource TextMuted}" Margin="0,0,0,6" TextWrapping="Wrap" Text="Not read yet."/>
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="ToolkitTweakDetail" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6" Text="Select an item."/>
                                        <Button x:Name="ToolkitTweakGoButton" Content="Open in its category" HorizontalAlignment="Left" Margin="0" ToolTip="Show this item on its category page, where you can stage, preview and apply it."/>
                                    </StackPanel>
                                </Border>
                                <ContentControl x:Name="ToolkitTweakListHost" Focusable="False"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Features" ToolTip="Optional Windows features and capabilities (WSL, Hyper-V, Sandbox, .NET 3.5, OpenSSH)">
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="ToolkitFeatureSummary" DockPanel.Dock="Top" Style="{StaticResource TextMuted}" Margin="0,0,0,6" TextWrapping="Wrap" Text="Not read yet."/>
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="ToolkitFeatureDetail" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6" Text="Select a feature."/>
                                        <WrapPanel>
                                            <Button x:Name="ToolkitFeatureEnableButton" Content="Enable" ToolTip="Confirm, write a snapshot and enable this feature. Needs administrator rights."/>
                                            <Button x:Name="ToolkitFeatureDisableButton" Content="Disable" Margin="0" ToolTip="Confirm, write a snapshot and disable this feature. Features other tools depend on are never disabled."/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <ContentControl x:Name="ToolkitFeatureListHost" Focusable="False"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Fixes" ToolTip="Repair fixes; each shows every step before it runs">
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="ToolkitFixSummary" DockPanel.Dock="Top" Style="{StaticResource TextMuted}" Margin="0,0,0,6" TextWrapping="Wrap" Text="Each fix shows its steps first. Fixes that need a restart create a restore point before they run."/>
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="ToolkitFixDetail" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6" Text="Select a fix to see its steps."/>
                                        <Button x:Name="ToolkitFixRunButton" Content="Run fix" HorizontalAlignment="Left" Margin="0" ToolTip="Shows the steps again for confirmation, then runs the fix and reports each step."/>
                                    </StackPanel>
                                </Border>
                                <ContentControl x:Name="ToolkitFixListHost" Focusable="False"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Panels" ToolTip="Classic Windows tools and consoles">
                            <DockPanel Margin="0,8,0,0">
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="ToolkitPanelDetail" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6" Text="Select a panel."/>
                                        <Button x:Name="ToolkitPanelOpenButton" Content="Open" HorizontalAlignment="Left" Margin="0" ToolTip="Open this Windows tool. Opening changes nothing by itself."/>
                                    </StackPanel>
                                </Border>
                                <ContentControl x:Name="ToolkitPanelListHost" Focusable="False"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Updates" ToolTip="Windows Update deferrals, driver exclusion and active hours. There is no 'disable updates'.">
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="ToolkitUpdateSummary" DockPanel.Dock="Top" Style="{StaticResource TextMuted}" Margin="0,0,0,6" TextWrapping="Wrap" Text="iG Windows Tuner never disables Windows Update. Defer feature updates, keep your drivers, set active hours, or pause updates natively in Settings."/>
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="ToolkitUpdateDetail" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6" Text="Select an item."/>
                                        <WrapPanel>
                                            <Button x:Name="ToolkitUpdateGoButton" Content="Open in its category" ToolTip="Show this item on its category page, where you can stage, preview and apply it."/>
                                            <Button x:Name="ToolkitUpdatePauseButton" Content="Pause updates in Settings" Margin="0" ToolTip="Open Settings > Windows Update, where updates can be paused natively."/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <ContentControl x:Name="ToolkitUpdateListHost" Focusable="False"/>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- Diagnostics & Network -->
                <Grid x:Name="PageDiagnostics" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <DockPanel>
                            <Button x:Name="DiagRefreshButton" DockPanel.Dock="Right" Content="Refresh" Margin="0" VerticalAlignment="Top" ToolTip="Sample DPC/ISR and read reliability, crash, boot, driver and update data again (read-only)."/>
                            <Button x:Name="DiagReportButton" DockPanel.Dock="Right" Content="Export system report" Margin="0,0,10,0" VerticalAlignment="Top" ToolTip="Write the full read-only system report (HTML) to the Reports folder. Takes about a minute."/>
                            <TextBlock Style="{StaticResource TextTitle}" Text="Diagnostics &amp; network"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource TextMuted}" Text="Read-only. The DNS benchmark and the latency test send network traffic only when you press their buttons; nothing on this page changes the system."/>
                    </StackPanel>
                    <TabControl x:Name="DiagTabs" Grid.Row="1" Margin="0,10,0,0" Background="Transparent" BorderThickness="0">
                        <TabItem Header="Overview" ToolTip="DPC and ISR time, reliability history, crashes and boot performance">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,-8,8">
                                    <Border x:Name="DiagDpcCard" Style="{StaticResource Card}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource TextMuted}" Text="Interrupt time (DPC / ISR)"/>
                                            </StackPanel>
                                            <TextBlock x:Name="DiagDpcValue" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" Margin="0,4,0,2" TextTrimming="CharacterEllipsis" Text="-"/>
                                            <TextBlock x:Name="DiagDpcNote" Style="{StaticResource TextMuted}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Text="Not read yet."/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="DiagStabilityCard" Style="{StaticResource Card}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource TextMuted}" Text="Stability index"/>
                                            </StackPanel>
                                            <TextBlock x:Name="DiagStabilityValue" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" Margin="0,4,0,2" TextTrimming="CharacterEllipsis" Text="-"/>
                                            <TextBlock x:Name="DiagStabilityNote" Style="{StaticResource TextMuted}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Text="Not read yet."/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="DiagCrashCard" Style="{StaticResource Card}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource TextMuted}" Text="Crashes (30 days)"/>
                                            </StackPanel>
                                            <TextBlock x:Name="DiagCrashValue" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" Margin="0,4,0,2" TextTrimming="CharacterEllipsis" Text="-"/>
                                            <TextBlock x:Name="DiagCrashNote" Style="{StaticResource TextMuted}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Text="Not read yet."/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="DiagBootCard" Style="{StaticResource Card}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource TextMuted}" Text="Boot time"/>
                                            </StackPanel>
                                            <TextBlock x:Name="DiagBootValue" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" Margin="0,4,0,2" TextTrimming="CharacterEllipsis" Text="-"/>
                                            <TextBlock x:Name="DiagBootNote" Style="{StaticResource TextMuted}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Text="Not read yet."/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <ContentControl x:Name="DiagEventListHost" Grid.Row="1" Focusable="False"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Drivers" ToolTip="Non-Microsoft drivers with version, date and signer">
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="DiagDriverSummary" DockPanel.Dock="Top" Style="{StaticResource TextMuted}" Margin="0,0,0,6" TextWrapping="Wrap" Text="Not read yet."/>
                                <ContentControl x:Name="DiagDriverListHost" Focusable="False"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Windows Update" ToolTip="Update services, pending restart, policies and history (read-only)">
                            <DockPanel Margin="0,8,0,0">
                                <TextBox x:Name="DiagUpdateText" DockPanel.Dock="Top" MaxHeight="190" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" VerticalContentAlignment="Top" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FontSizeCaption}" Text="Not read yet." ToolTip="Windows Update status. Policies change only through catalog items."/>
                                <ContentControl x:Name="DiagUpdateListHost" Focusable="False"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Network tools" ToolTip="Adapter properties, DNS benchmark and latency/jitter/loss test">
                            <DockPanel Margin="0,8,0,0">
                                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <WrapPanel>
                                            <Button x:Name="DiagDnsButton" Content="Run DNS benchmark" ToolTip="Resolve gaming-related names against your DNS servers and public resolvers and compare latency. Sends DNS queries; changes nothing."/>
                                            <TextBox x:Name="DiagLatencyBox" Width="260" Margin="0,0,10,0" VerticalAlignment="Center" Text="1.1.1.1, 9.9.9.9" ToolTip="Host names or IP addresses, separated by commas (for example a game server you know)."/>
                                            <Button x:Name="DiagLatencyButton" Content="Measure latency" Margin="0" ToolTip="Send 20 echo requests to each target and show latency, jitter and loss. Changes nothing."/>
                                        </WrapPanel>
                                        <TextBox x:Name="DiagNetText" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,8,0,0" MaxHeight="160" VerticalScrollBarVisibility="Auto" ToolTip="Results of the DNS benchmark and latency test."/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="DiagAdapterSummary" DockPanel.Dock="Top" Style="{StaticResource TextMuted}" Margin="0,0,0,6" TextWrapping="Wrap" Text="Adapter properties: not read yet."/>
                                <ContentControl x:Name="DiagAdapterListHost" Focusable="False"/>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- Network Test -->
                <ScrollViewer x:Name="PageNetTest" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextTitle}" Text="Network test"/>
                        <TextBlock Style="{StaticResource TextMuted}" TextWrapping="Wrap" Text="Measures latency, jitter, packet loss and stability to your router, your ISP and the internet, traces the path, detects your connection type and recommends the Windows adjustments that lower latency and jitter. Read-only: it only sends pings and DNS queries."/>
                        <WrapPanel Margin="0,10,0,0">
                            <TextBlock Text="Duration" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="NetDurationBox" Width="160" Margin="0,0,12,0" ToolTip="Quick: 10 seconds. Standard: 30 seconds. Extended: 2 minutes, best for spotting spikes and loss bursts."/>
                            <TextBox x:Name="NetTargetsBox" Width="260" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Optional: up to 4 game servers or other hosts (names or IP addresses, separated by commas) to measure as well."/>
                            <Button x:Name="NetRunButton" Style="{StaticResource AccentButton}" Content="Run test" ToolTip="Run the network test (read-only)."/>
                            <Button x:Name="NetLoadButton" Content="Measure under load" ToolTip="Start a speed test or large download first; this measures latency for 20 seconds while the line is busy and grades bufferbloat."/>
                            <Button x:Name="NetExportButton" Content="Export report" Margin="0" ToolTip="Save the last result as an HTML report (no scripts) in the Reports folder."/>
                        </WrapPanel>
                        <TextBlock x:Name="NetStatusText" Style="{StaticResource TextMuted}" Margin="0,8,0,0" Text="Not run yet."/>
                        <UniformGrid Columns="6" Margin="0,8,0,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0" ToolTip="Overall grade: the weakest of latency, jitter, packet loss and stability.">
                                <StackPanel><TextBlock Style="{StaticResource TextMuted}" Text="Grade"/><TextBlock x:Name="NetGradeText" FontSize="{DynamicResource FontSizeTitleLarge}" FontWeight="SemiBold" Text="-"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0" ToolTip="Score from 0 to 100 and the estimated call quality (MOS, 1 to 4.5).">
                                <StackPanel><TextBlock Style="{StaticResource TextMuted}" Text="Score / MOS"/><TextBlock x:Name="NetScoreText" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Text="-"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0" ToolTip="Median round-trip time to the best internet anchor.">
                                <StackPanel><TextBlock Style="{StaticResource TextMuted}" Text="Ping"/><TextBlock x:Name="NetLatencyText" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Text="-"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0" ToolTip="Average difference between consecutive pings; high jitter causes rubber-banding.">
                                <StackPanel><TextBlock Style="{StaticResource TextMuted}" Text="Jitter"/><TextBlock x:Name="NetJitterText" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Text="-"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0" ToolTip="Share of pings without a reply.">
                                <StackPanel><TextBlock Style="{StaticResource TextMuted}" Text="Packet loss"/><TextBlock x:Name="NetLossText" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Text="-"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0" ToolTip="Stability grade from latency spikes and loss bursts, and the bufferbloat grade under load.">
                                <StackPanel><TextBlock Style="{StaticResource TextMuted}" Text="Stability / load"/><TextBlock x:Name="NetStabilityText" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Text="-"/></StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Connection" FontWeight="SemiBold"/>
                                <TextBlock x:Name="NetConnectionText" TextWrapping="Wrap" Margin="0,4,0,0" Text="-"/>
                                <TextBlock x:Name="NetEvidenceText" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource TextSection}" Text="Measurements" Margin="0,12,0,4"/>
                        <ItemsControl x:Name="NetTargetList" ItemTemplate="{StaticResource ManageRowTemplate}"/>
                        <DockPanel Margin="0,12,0,4">
                            <Button x:Name="NetApplyButton" DockPanel.Dock="Right" Content="Preview recommended adjustments" Margin="0" ToolTip="Stage the recommended Windows items and show the dry-run preview. Nothing changes until you press Apply."/>
                            <TextBlock x:Name="NetRecoTitle" Style="{StaticResource TextSection}" Text="Recommended Windows adjustments" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl x:Name="NetRecoList" ItemTemplate="{StaticResource ManageRowTemplate}"/>
                        <TextBlock Style="{StaticResource TextSection}" Text="Router, Wi-Fi and ISP" Margin="0,12,0,4"/>
                        <ItemsControl x:Name="NetGuidanceList" ItemTemplate="{StaticResource ManageRowTemplate}"/>
                        <TextBlock Style="{StaticResource TextSection}" Text="Path to the internet" Margin="0,12,0,4"/>
                        <TextBox x:Name="NetPathText" IsReadOnly="True" TextWrapping="NoWrap" BorderThickness="0" Background="Transparent" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FontSizeCaption}" HorizontalScrollBarVisibility="Auto" ToolTip="Each router (hop) between this PC and 1.1.1.1 with its response time and name."/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ASR Center -->
                <Grid x:Name="PageAsr" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="AsrHardeningButton" Content="Hardening items" ToolTip="Back to the Security items of the catalog."/>
                            <Button x:Name="AsrSelfButton" Style="{StaticResource AccentButton}" Content="ASR Center" ToolTip="You are here: Security > ASR Center."/>
                            <Button x:Name="AsrDefenderButton" Content="Defender settings" Margin="0" ToolTip="Every Microsoft Defender Antivirus setting and Defender Group Policy."/>
                        </StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="AsrPromoteButton" Content="Audit to Block..." ToolTip="Review the rules in Audit with their events of the last 7 days and move the quiet ones to Block, with a preview first."/>
                                <Button x:Name="AsrRecommendButton" Style="{StaticResource AccentButton}" Content="Apply recommendations" ToolTip="Raise every rule that is below its recommended mode (never lowers a rule). Confirmation and snapshot first."/>
                                <Button x:Name="AsrRefreshButton" Content="Refresh" Margin="0" ToolTip="Read every rule's mode, exclusions and events again (read-only)."/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource TextTitle}"><Run Text="Security" Foreground="{DynamicResource BrushTextMuted}"/><Run Text="  &#x203A;  " Foreground="{DynamicResource BrushTextMuted}"/><Run Text="ASR Center"/></TextBlock>
                        </DockPanel>
                        <TextBlock Style="{StaticResource TextMuted}" TextWrapping="Wrap" Text="Attack surface reduction rules block behaviors malware relies on. Each rule shows what it means for games, launchers and mods. Audit first, then move quiet rules to Block. Rules managed by Group Policy or MDM are locked."/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock x:Name="AsrSummaryIcon" Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,8,0"/>
                        <TextBlock x:Name="AsrSummaryText" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Text="Not read yet."/>
                    </StackPanel>
                    <TabControl x:Name="AsrTabs" Grid.Row="2" Margin="0,10,0,0">
                        <TabItem Header="Rules" ToolTip="Every ASR rule with its mode, gamer impact and events">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="340"/>
                                </Grid.ColumnDefinitions>
                                <ContentControl x:Name="AsrGridHost" Grid.Column="0" Margin="0,0,12,0" Focusable="False"/>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock x:Name="AsrDetName" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" TextWrapping="Wrap" Text="Select a rule"/>
                                            <TextBlock x:Name="AsrDetMeta" Style="{StaticResource TextMuted}" Margin="0,2,0,6"/>
                                            <TextBlock x:Name="AsrDetDescription" TextWrapping="Wrap" Margin="0,0,0,8" Text="Pick a rule to see what it blocks, what it means for games, its events and its exclusions."/>
                                            <StackPanel x:Name="AsrDetPanel" Visibility="Collapsed">
                                                <TextBlock Style="{StaticResource TextSection}" Text="Gamer impact" Margin="0,4,0,4"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock x:Name="AsrDetImpactIcon" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="AsrDetImpactLevel" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <TextBlock x:Name="AsrDetImpact" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <TextBlock Style="{StaticResource TextSection}" Text="Mode" Margin="0,8,0,6"/>
                                                <Border Style="{StaticResource SegmentHost}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="AsrModeNotConfigured" Style="{StaticResource Segment}" GroupName="asrmode" Content="Off" Tag="NotConfigured" AutomationProperties.Name="Mode: not configured (off)"/>
                                                        <RadioButton x:Name="AsrModeAudit" Style="{StaticResource Segment}" GroupName="asrmode" Content="Audit" Tag="Audit" AutomationProperties.Name="Mode: audit"/>
                                                        <RadioButton x:Name="AsrModeWarn" Style="{StaticResource Segment}" GroupName="asrmode" Content="Warn" Tag="Warn" AutomationProperties.Name="Mode: warn"/>
                                                        <RadioButton x:Name="AsrModeBlock" Style="{StaticResource Segment}" GroupName="asrmode" Content="Block" Tag="Block" AutomationProperties.Name="Mode: block"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock x:Name="AsrModeHelp" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                                <Button x:Name="AsrSetModeButton" Content="Set mode" HorizontalAlignment="Left" Margin="0,0,0,6" ToolTip="Change this rule to the selected mode after a confirmation (snapshot first). Needs administrator rights."/>
                                                <TextBlock Style="{StaticResource TextSection}" Text="Exclusions" Margin="0,8,0,4"/>
                                                <TextBlock Style="{StaticResource TextMuted}" TextWrapping="Wrap" Text="Prefer the exact program file. Windows folders, whole drives, Downloads, Desktop, temp folders and user-profile folders are refused."/>
                                                <ListBox x:Name="AsrExclusionList" MinHeight="54" MaxHeight="120" Margin="0,6,0,0" AutomationProperties.Name="Exclusions" ToolTip="Exclusions that apply to the selected rule (per-rule) or to every rule (global)."/>
                                                <TextBox x:Name="AsrExclusionBox" Margin="0,6,0,4" Tag="D:\Games\MyGame\MyGame.exe" AutomationProperties.Name="Program to exclude" ToolTip="Full path of the program to exclude, for example D:\Games\MyGame\MyGame.exe or %ProgramFiles%\Vendor\Tool.exe."/>
                                                <CheckBox x:Name="AsrGlobalBox" Style="{StaticResource FilterCheck}" Content="Apply to all ASR rules (global)" ToolTip="Unticked: the exclusion applies to the selected rule only (recommended). Ticked: it applies to every ASR rule."/>
                                                <WrapPanel Margin="0,4,0,0">
                                                    <Button x:Name="AsrAddExclusionButton" Content="Add exclusion" ToolTip="Validate the path and add it after a confirmation (snapshot first). Needs administrator rights."/>
                                                    <Button x:Name="AsrRemoveExclusionButton" Content="Remove selected" Margin="0" ToolTip="Remove the exclusion selected in the list after a confirmation (snapshot first). Needs administrator rights."/>
                                                </WrapPanel>
                                                <ItemsControl x:Name="AsrDetSources" Margin="0,10,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource LinkButton}" Content="{Binding}" Tag="{Binding}" ToolTip="Open the Microsoft documentation in your browser."/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Events (7 days)" ToolTip="What the rules, controlled folder access and network protection reported in the last 7 days">
                            <DockPanel Margin="0,8,0,0">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Button x:Name="AsrAuditExcludeButton" DockPanel.Dock="Right" Content="Use as exclusion" Margin="12,0,0,0" ToolTip="Open the rule of this event and copy the suggested file into the exclusion box (nothing is added until you press Add exclusion)."/>
                                    <TextBlock x:Name="AsrAuditSummaryText" Style="{StaticResource TextMuted}" TextWrapping="Wrap" VerticalAlignment="Center" Text="Reading the Defender log..."/>
                                </DockPanel>
                                <ContentControl x:Name="AsrAuditGridHost" Focusable="False"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Exploit protection" ToolTip="System-wide exploit protection and the per-program settings (read-only)">
                            <DockPanel Margin="0,8,0,0">
                                <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="System-wide settings" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ExpSystemText" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Not read yet."/>
                                    </StackPanel>
                                </Border>
                                <TextBlock DockPanel.Dock="Top" x:Name="ExpSummaryText" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6" Text="Programs with their own exploit protection settings. Games and anti-cheat programs are marked and locked: their settings come from the game or the anti-cheat. Change mitigations through the Security items, which keep a snapshot."/>
                                <ContentControl x:Name="ExpGridHost" Focusable="False"/>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- Security > Defender settings -->
                <Grid x:Name="PageDefender" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="DefHardeningButton" Content="Hardening items" ToolTip="Back to the Security items of the catalog."/>
                            <Button x:Name="DefAsrButton" Content="ASR Center" ToolTip="Attack surface reduction rules."/>
                            <Button x:Name="DefSelfButton" Style="{StaticResource AccentButton}" Content="Defender settings" Margin="0" ToolTip="You are here: Security > Defender settings."/>
                        </StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="DefPrefsViewButton" Style="{StaticResource AccentButton}" Content="Defender preferences" ToolTip="Every Microsoft Defender Antivirus preference (Get-MpPreference), also the ones Windows Security does not show."/>
                                <Button x:Name="DefPolicyViewButton" Content="Group Policy" ToolTip="Every Defender Group Policy setting of the installed ADMX files, also those without a preference (heuristics, packed executables, notifications, ...)."/>
                                <Button x:Name="DefRefreshButton" Content="Refresh" Margin="0" ToolTip="Read the settings again (read-only)."/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource TextTitle}"><Run Text="Security" Foreground="{DynamicResource BrushTextMuted}"/><Run Text="  &#x203A;  " Foreground="{DynamicResource BrushTextMuted}"/><Run Text="Defender settings"/></TextBlock>
                        </DockPanel>
                        <TextBlock Style="{StaticResource TextMuted}" TextWrapping="Wrap" Text="Every Microsoft Defender Antivirus setting with its current and recommended value, including the hidden ones. Protection settings only move toward on, values that turn a protection off are refused, and settings a policy controls are changed through that policy. Every change writes a snapshot you can revert in Backups &amp; Logs (a protection that is on stays on)."/>
                        <WrapPanel Margin="0,10,0,6" VerticalAlignment="Center">
                            <ComboBox x:Name="DefCategoryBox" MinWidth="250" ToolTip="Show one category"/>
                        </WrapPanel>
                        <TextBlock x:Name="DefSummaryText" Style="{StaticResource TextMuted}" Margin="0,0,0,6" TextWrapping="Wrap" Text="Not read yet."/>
                    </StackPanel>
                    <ContentControl x:Name="DefListHost" Grid.Row="2" Grid.Column="0" Focusable="False"/>
                    <ContentControl x:Name="DefPolicyListHost" Grid.Row="2" Grid.Column="0" Visibility="Collapsed" Focusable="False"/>
                    <ScrollViewer Grid.Row="2" Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="DefDetName" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" TextWrapping="Wrap" Text="Select a setting"/>
                            <TextBlock x:Name="DefDetMeta" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                            <TextBlock x:Name="DefDetDescription" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StackPanel x:Name="DefEditPanel">
                                <TextBlock Text="Value" FontWeight="SemiBold"/>
                                <ComboBox x:Name="DefValueBox" Margin="0,4,0,4" HorizontalAlignment="Stretch" DisplayMemberPath="Label" ToolTip="Values marked 'not allowed' turn a protection off or are refused for another reason."/>
                                <TextBox x:Name="DefValueText" Margin="0,4,0,4" ToolTip="Type the new value."/>
                                <TextBlock x:Name="DefValueHelp" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button x:Name="DefApplyButton" Style="{StaticResource AccentButton}" Content="Apply value" ToolTip="Check the value, then change it after a confirmation (snapshot first). Needs administrator rights."/>
                                    <Button x:Name="DefRecommendButton" Content="Use recommended" Margin="0" ToolTip="Pick the recommended value for this setting (you still press Apply value)."/>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel x:Name="DefPolicyPanel" Visibility="Collapsed">
                                <TextBlock Text="Local Group Policy state" FontWeight="SemiBold"/>
                                <ComboBox x:Name="DefPolicyStateBox" Margin="0,4,0,4" HorizontalAlignment="Stretch" ToolTip="Enabled and Disabled write the policy to the Local Group Policy Object; Not configured removes it."/>
                                <TextBlock x:Name="DefPolicyHelp" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button x:Name="DefPolicyApplyButton" Style="{StaticResource AccentButton}" Content="Set policy" HorizontalAlignment="Left" ToolTip="Set the policy after a confirmation (Group Policy backup first). States that turn a protection off are refused. Needs administrator rights."/>
                            </StackPanel>
                            <Button x:Name="DefDocButton" Style="{StaticResource LinkButton}" Margin="0,12,0,0" HorizontalAlignment="Left" Content="Microsoft documentation" ToolTip="Open the Microsoft documentation in your browser."/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Cleaner -->
                <Grid x:Name="PageCleaner" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="CleanScanButton" Content="Scan" ToolTip="Find and size what can be cleaned. Nothing is deleted."/>
                                <Button x:Name="CleanRunButton" Style="{StaticResource AccentButton}" Content="Clean selected" IsEnabled="False" ToolTip="Delete only the files the last scan found for the ticked rules, after a confirmation."/>
                                <Button x:Name="CleanCancelButton" Content="Cancel" IsEnabled="False" Margin="0" ToolTip="Stop the scan or clean after the current file."/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource TextTitle}" Text="Cleaner"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource TextMuted}" Text="Scan first: iG Windows Tuner lists what each rule would remove and deletes nothing. Tick the rules you want, then Clean selected. Only files found by the scan are deleted; files in use, changed since the scan, cloud placeholders and protected locations are skipped, apps are never closed for you, and every deleted path is logged."/>
                    </StackPanel>
                    <WrapPanel Grid.Row="1" Margin="0,10,0,8" VerticalAlignment="Center">
                        <TextBlock Text="Rules up to" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CleanLevelBox" SelectedIndex="0" ToolTip="Standard: safe everyday rules. Advanced: larger caches and servicing cleanup. Expert: rules with permanent side effects (read each hint).">
                            <ComboBoxItem Content="Standard"/>
                            <ComboBoxItem Content="Advanced"/>
                            <ComboBoxItem Content="Expert"/>
                        </ComboBox>
                        <CheckBox x:Name="CleanOptInBox" Style="{StaticResource FilterCheck}" Content="Include opt-in rules" ToolTip="Also scan rules that are off by default (browsers, shader caches, developer caches, Downloads)."/>
                        <TextBlock x:Name="CleanSummaryText" Style="{StaticResource TextMuted}" VerticalAlignment="Center" Text="No scan yet."/>
                    </WrapPanel>
                    <ContentControl x:Name="CleanerListHost" Grid.Row="2" Focusable="False"/>
                </Grid>

                <!-- Disk analyzer -->
                <Grid x:Name="PageDisk" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource TextTitle}" Text="Disk Analyzer"/>
                        <TextBlock Style="{StaticResource TextMuted}" Text="Read-only: finds the largest folders and files under a folder or drive. Junctions, symbolic links and cloud placeholders are not followed, so nothing is counted twice or downloaded. Double-click a folder to look inside it."/>
                    </StackPanel>
                    <DockPanel Grid.Row="1" Margin="0,10,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="DiskAnalyzeButton" Style="{StaticResource AccentButton}" Content="Analyze" ToolTip="Measure the folder (read-only). A whole drive can take a few minutes."/>
                            <Button x:Name="DiskCancelButton" Content="Cancel" IsEnabled="False" ToolTip="Stop the analysis and show what was measured so far."/>
                            <Button x:Name="DiskOpenButton" Content="Show in Explorer" Margin="0" ToolTip="Open the selected folder, or the folder that contains the selected file, in File Explorer."/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="DiskPathBox" Margin="0,0,10,0" VerticalContentAlignment="Center" ToolTip="Folder or drive to analyze, for example C:\ or D:\Games"/>
                    </DockPanel>
                    <TextBlock x:Name="DiskSummaryText" Grid.Row="2" Style="{StaticResource TextMuted}" Text="Enter a folder or drive and press Analyze." Margin="0,0,0,6"/>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextSection}" Text="Largest folders"/>
                            <ContentControl x:Name="DiskFolderListHost" Focusable="False"/>
                        </DockPanel>
                        <DockPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextSection}" Text="Largest files"/>
                            <ContentControl x:Name="DiskFileListHost" Focusable="False"/>
                        </DockPanel>
                    </Grid>
                </Grid>

                <!-- Startup apps -->
                <Grid x:Name="PageStartup" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <DockPanel>
                            <Button x:Name="StartupRefreshButton" DockPanel.Dock="Right" Content="Refresh" Margin="0" VerticalAlignment="Top" ToolTip="Re-read the startup entries (read-only)."/>
                            <TextBlock Style="{StaticResource TextTitle}" Text="Startup Apps"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource TextMuted}" Text="Entries from the Run keys and Startup folders. Toggling uses the StartupApproved mechanism (like Task Manager); entries are never deleted, and every change is snapshotted. Machine-wide entries need administrator rights." Margin="0,0,0,10"/>
                    </StackPanel>
                    <ContentControl x:Name="StartupListHost" Grid.Row="1" Focusable="False"/>
                </Grid>

                <!-- Backups and logs -->
                <Grid x:Name="PageBackups" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource TextTitle}" Text="Backups &amp; Logs"/>
                        <TextBlock Style="{StaticResource TextMuted}" Text="Every apply, revert and reset writes a JSON snapshot of the exact previous values to %ProgramData%\iGWindowsTuner\Backups before anything changes. Logs (text and JSON lines) are in %ProgramData%\iGWindowsTuner\Logs."/>
                        <WrapPanel Margin="0,10,0,10">
                            <Button x:Name="BackupRevertLastButton" Content="Revert last apply" ToolTip="Restore every value captured before the most recent apply or preset."/>
                            <Button x:Name="BackupRevertSelectedButton" Content="Revert selected snapshot" ToolTip="Restore the values stored in the snapshot selected below."/>
                            <Button x:Name="OpenBackupsButton" Content="Open backups folder" ToolTip="Open %ProgramData%\iGWindowsTuner\Backups in File Explorer."/>
                            <Button x:Name="OpenLogsButton" Content="Open logs folder" ToolTip="Open the iG Windows Tuner log folder in File Explorer."/>
                        </WrapPanel>
                    </StackPanel>
                    <ContentControl x:Name="SnapshotListHost" Grid.Row="1" Focusable="False"/>
                </Grid>

                <!-- Rejected tweaks -->
                <Grid x:Name="PageRejected" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource TextTitle}" Text="Rejected Tweaks"/>
                        <TextBlock Style="{StaticResource TextMuted}" TextWrapping="Wrap" Text="Popular tweaks iG Windows Tuner does not recommend: placebo, obsolete, unstable, security-reducing or anti-cheat-hostile. Reversible performance and network items can be applied at your own risk from the Risk Zone; items that turn off security protections or cannot be undone are not offered." Margin="0,0,0,10"/>
                    </StackPanel>
                    <ContentControl x:Name="RejectedListHost" Grid.Row="1" Focusable="False"/>
                </Grid>

                <!-- About -->
                <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource TextTitle}" Text="About iG Windows Tuner"/>
                        <TextBlock x:Name="AboutText" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Details pane -->
            <Border x:Name="DetailsPane" Grid.Column="2" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                    <StackPanel>
                        <TextBlock x:Name="DetName" Text="Select a tweak" FontSize="{DynamicResource FontSizeTitleSmall}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetMeta" Style="{StaticResource TextMuted}" Text="" Margin="0,2,0,8"/>
                        <Border x:Name="DetWarning" Visibility="Collapsed" Background="{DynamicResource BrushDangerSoft}" BorderBrush="{DynamicResource BrushDangerStrong}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                            <TextBlock x:Name="DetWarningText" TextWrapping="Wrap" Foreground="{DynamicResource BrushDanger}"/>
                        </Border>
                        <TextBlock x:Name="DetDescription" TextWrapping="Wrap" Text="Details, exact changes, sources and how to revert appear here."/>
                        <TextBlock Style="{StaticResource TextSection}" Text="Exact changes (current -> target)"/>
                        <ItemsControl x:Name="DetChanges">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Target}" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap"/>
                                            <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}" Margin="0,3,0,0"><Run Text="{Binding Current, Mode=OneWay}" Foreground="{DynamicResource BrushTextMuted}"/><Run Text="  ->  "/><Run Text="{Binding Desired, Mode=OneWay}" Foreground="{DynamicResource BrushAccent}"/></TextBlock>
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource TextMuted}" FontSize="{DynamicResource FontSizeCaption}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource TextSection}" Text="Sources"/>
                        <ItemsControl x:Name="DetSources">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LinkButton}" Content="{Binding}" Tag="{Binding}" Margin="0,0,0,4" ToolTip="Open in your browser"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="DetEvidence" Style="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                        <TextBlock Style="{StaticResource TextSection}" Text="How to revert"/>
                        <TextBlock x:Name="DetRevert" Style="{StaticResource TextMuted}"/>
                        <Button x:Name="DetResetButton" Content="Stage: reset to Windows default" HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="False" ToolTip="Stage a reset of this tweak to the documented Windows default. Nothing changes until you press Apply."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Toasts (bottom right): results of actions, with Undo where possible -->
        <StackPanel x:Name="ToastHost" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,12" Panel.ZIndex="50" AutomationProperties.AutomationId="ToastHost"/>

        <!-- Staged changes bar -->
        <Border Grid.Row="3" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Margin="0,0,8,0"/>
                    <TextBlock x:Name="PendingText" Text="0 pending" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Style="{StaticResource TextMuted}" Text="Ready." TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <DockPanel Margin="0,4,0,0">
                        <Button x:Name="BusyCancelButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Cancel" Margin="10,0,0,0" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="Cancel the background reads" AutomationProperties.Name="Cancel background reads"/>
                        <ProgressBar x:Name="BusyBar" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" Visibility="Hidden"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="PreviewButton" Content="Preview" ToolTip="Dry run: show every value that would change. Nothing is modified." IsEnabled="False"/>
                    <Button x:Name="ApplyButton" Style="{StaticResource AccentButton}" Content="Apply" ToolTip="Create a restore point and a JSON snapshot, then apply the staged changes." IsEnabled="False"/>
                    <Button x:Name="DiscardButton" Content="Discard" ToolTip="Unstage everything." IsEnabled="False" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Log console -->
        <Expander Grid.Row="4" x:Name="LogExpander" Header="Log" IsExpanded="False" Padding="16,0,16,8" Background="{DynamicResource BrushBackground}" Foreground="{DynamicResource BrushText}">
            <TextBox x:Name="LogBox" Height="140" ToolTip="Log of this session. The full logs are in the logs folder." IsReadOnly="True" FontFamily="{StaticResource FontMono}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Expander>
    </Grid>
</Window>
