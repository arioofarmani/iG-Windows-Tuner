    "power.fast-startup-off",
    "power.power-throttling-on",
    "gfx.game-mode",
    "gfx.background-recording-off",
    "gfx.windowed-optimizations",
    "gfx.vrr-optimizations",
    "input.pointer-precision-off",
    "input.accessibility-hotkeys-off",
    "net.eee-off",
    "net.rss-on",
    "net.tcp-autotuning-normal",
    "net.wifi-disable",
    "net.delivery-optimization-p2p-off",
    "net.doh-quad9",
    "privacy.diagnostic-data-required",
    "privacy.ads-suggestions-off",
    "privacy.widgets-off",
    "privacy.edge-background-off",
    "privacy.update-active-hours",
    "privacy.keep-drivers",
    "privacy.ai-features-off",
    "sec.hvci-on",
    "sec.vulnerable-driver-blocklist",
    "sec.lsa-protection",
    "sec.defender-hardening",
    "sec.network-protection",
    "sec.gaming-friendly-scans",
    "sec.asr-baseline",
    "sec.asr-office-block",
    "sec.cfa-audit",
    "sec.uac-on",
    "sec.uac-always-notify",
    "sec.llmnr-off",
