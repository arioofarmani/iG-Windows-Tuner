  <displayName>Fixture</displayName>
  <description>Synthetic Device Guard fixture</description>
  <resources>
    <stringTable>
      <string id="DeviceGuard">Device Guard</string>
      <string id="VbsShaped">Turn on virtualization based security (fixture)</string>
