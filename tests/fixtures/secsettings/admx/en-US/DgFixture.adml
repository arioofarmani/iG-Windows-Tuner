      <string id="Off">Disabled</string>
      <string id="WithLock">Enabled with UEFI lock</string>
      <string id="NoLock">Enabled without lock</string>
    </stringTable>
    <presentationTable>
      <presentation id="VbsShaped">
        <dropdownList refId="HvciDrop" defaultItem="2">Memory integrity</dropdownList>
        <dropdownList refId="FakeDrop" defaultItem="0">Fake isolation</dropdownList>
